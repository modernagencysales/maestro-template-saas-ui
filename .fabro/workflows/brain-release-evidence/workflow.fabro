digraph BrainReleaseEvidence {
  graph [
    goal="Prove one frozen Maestro Brain release candidate through staging, pilot, and rollback",
    inputs="workdir,evidence_dir,release_commit",
    model_stylesheet="#operate { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; } #review { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }",
    rankdir=LR
  ]
  start [shape=Mdiamond]
  exit [shape=Msquare]
  preflight [shape=parallelogram, goal_gate=true, retry_target=preflight, max_retries=1, timeout="1800s", script="set -euo pipefail; WORKDIR='{{ inputs.workdir|default('__required_workdir__') }}'; EVIDENCE='{{ inputs.evidence_dir|default('__required_evidence__') }}'; RELEASE='{{ inputs.release_commit|default('__required_release_commit__') }}'; rtk proxy test \"${WORKDIR#/}\" != \"$WORKDIR\"; rtk proxy test \"${EVIDENCE#/}\" != \"$EVIDENCE\"; cd \"$WORKDIR\"; rtk proxy test \"$(rtk git rev-parse HEAD)\" = \"$RELEASE\"; rtk host-test-slot --class full pnpm verify; rtk pnpm deploy:doctor staging; rtk pnpm deploy:doctor production; rtk proxy mkdir -p \"$EVIDENCE/release\""]
  operate [label="Run Release Evidence", max_visits=2, timeout="604800s", prompt="For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifact. Execute S14-T01 and Appendices K/L/N for frozen candidate {{ inputs.release_commit|default('__required_release_commit__') }}. Before every mutating tool call, verify the target is under the exact release workdir or {{ inputs.evidence_dir|default('__required_evidence__') }}/release/release-result.json; never mutate the control checkout or any implementation worktree. Use only approved synthetic/pilot data and never record secrets or customer text. Follow docs/superpowers/execution/maestro-brain/release-evidence-schema.md exactly. Bind productReleaseCommit, every Buildkite check, stagingReceipt, providerReceipt, headlessReceipt, lifecycleReceipt, migrationReceipt, evalReceipt, capacityReceipt, promotionReceipt, rollbackReceipt, buildId and deployId to the frozen candidate. Preserve exact pilot full-cohort and activated denominators; do not round percentages. Prove compatible rollback and a distinct roll-forward ID without reverse migration. When attestationCommit differs, include the signed docs-only materiality record and exact unaffected-evidence set. Set reviewVerdict pending until independent review and recompute signatureSha256 from canonical JSON after every packet edit. Do not fabricate live credentials, hosted receipts, pilot agencies, elapsed time, or acceptance evidence. A missing context is no_go. Do not implement product fixes in this workflow: a material failure creates a scoped repair and a new candidate/pilot window."]
  review [label="Release Evidence Review", timeout="7200s", prompt="For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifact. Audit {{ inputs.evidence_dir|default('__required_evidence__') }}/release/release-result.json against S14-T01, Appendices J-N, and docs/superpowers/execution/maestro-brain/release-evidence-schema.md for exact candidate {{ inputs.release_commit|default('__required_release_commit__') }}. Never edit product/worktree files; the only allowed write is that exact release result. Reject any missing or extra Buildkite context, unbound receipt, inherited evidence without signed docs-only materiality, denominator shrinkage, rounded-down pilot numerator, shortened pilot, destructive rollback, missing roll-forward, stale canonical digest, or zero-tolerance incident. Never fabricate credentials, receipts, agencies, elapsed time, or acceptance evidence. Record binary reviewVerdict go/no_go and exact failed clauses; only go may use status launch_approved, and recompute signatureSha256 after the verdict mutation."]
  final_gate [shape=parallelogram, goal_gate=true, retry_target=review, max_retries=1, timeout="600s", script="set -euo pipefail; rtk pnpm --dir '{{ inputs.workdir|default('__required_workdir__') }}/tooling/brain-factory' exec tsx src/release-evidence-check.mts --evidence '{{ inputs.evidence_dir|default('__required_evidence__') }}' --release-commit '{{ inputs.release_commit|default('__required_release_commit__') }}'"]
  start -> preflight
  preflight -> operate [condition="outcome=succeeded"]
  preflight -> exit [label="blocked"]
  operate -> review -> final_gate
  final_gate -> exit [condition="outcome=succeeded"]
  final_gate -> review [label="no-go or invalid evidence"]
}
