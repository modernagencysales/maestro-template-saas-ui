digraph BrainIntegrateWave {
  graph [
    goal="Deterministically apply one immutable, dependency-safe cross-tranche Maestro Brain wave and prove its exact head",
    inputs="workdir,control_root,evidence_dir,integration_id,base_sha,selection_path,selection_payload_sha256,selection_file_sha256,mode,attempt,reservation_token",
    model_stylesheet="
      #review { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
    ",
    rankdir=LR
  ]
  start [shape=Mdiamond]
  exit [shape=Msquare]
  preflight [shape=parallelogram, goal_gate=true, retry_target=preflight, max_retries=1, timeout="600s", script="set -euo pipefail; WORKDIR='{{ inputs.workdir|default('__required_workdir__') }}'; CONTROL='{{ inputs.control_root|default('__required_control__') }}'; EVIDENCE='{{ inputs.evidence_dir|default('__required_evidence__') }}'; ID='{{ inputs.integration_id|default('__required_id__') }}'; BASE='{{ inputs.base_sha|default('__required_base__') }}'; SELECTION='{{ inputs.selection_path|default('__required_selection__') }}'; PAYLOAD_HASH='{{ inputs.selection_payload_sha256|default('__required_payload_hash__') }}'; FILE_HASH='{{ inputs.selection_file_sha256|default('__required_file_hash__') }}'; MODE='{{ inputs.mode|default('integrate') }}'; rtk proxy test \"${WORKDIR#/}\" != \"$WORKDIR\"; rtk proxy test \"${CONTROL#/}\" != \"$CONTROL\"; rtk proxy test \"${EVIDENCE#/}\" != \"$EVIDENCE\"; rtk proxy test -s \"$SELECTION\"; rtk proxy test \"$MODE\" = integrate -o \"$MODE\" = recover; rtk pnpm --dir \"$CONTROL/tooling/brain-factory\" exec tsx src/integration-wave-selection-check.mts --selection \"$SELECTION\" --integration-id \"$ID\" --base \"$BASE\" --selection-payload-sha256 \"$PAYLOAD_HASH\" --selection-file-sha256 \"$FILE_HASH\"; rtk proxy mkdir -p \"$EVIDENCE/integration/$ID\"; if [ \"$MODE\" = integrate ]; then rtk proxy test \"$(cd \"$WORKDIR\" && rtk proxy git rev-parse HEAD)\" = \"$BASE\"; fi"]
  apply_integration_wave [label="Apply Immutable Wave Deterministically", shape=parallelogram, goal_gate=true, retry_target=apply_integration_wave, max_retries=0, timeout="10800s", script="set -euo pipefail; WORKDIR='{{ inputs.workdir|default('__required_workdir__') }}'; CONTROL='{{ inputs.control_root|default('__required_control__') }}'; EVIDENCE='{{ inputs.evidence_dir|default('__required_evidence__') }}'; ID='{{ inputs.integration_id|default('__required_id__') }}'; BASE='{{ inputs.base_sha|default('__required_base__') }}'; SELECTION='{{ inputs.selection_path|default('__required_selection__') }}'; PAYLOAD_HASH='{{ inputs.selection_payload_sha256|default('__required_payload_hash__') }}'; FILE_HASH='{{ inputs.selection_file_sha256|default('__required_file_hash__') }}'; MODE='{{ inputs.mode|default('integrate') }}'; rtk pnpm --dir \"$CONTROL/tooling/brain-factory\" exec tsx src/apply-integration-wave.mts --workdir \"$WORKDIR\" --control-root \"$CONTROL\" --evidence \"$EVIDENCE\" --selection \"$SELECTION\" --integration-id \"$ID\" --base \"$BASE\" --selection-payload-sha256 \"$PAYLOAD_HASH\" --selection-file-sha256 \"$FILE_HASH\" --mode \"$MODE\""]
  dependencies [shape=parallelogram, goal_gate=true, retry_target=repair, timeout="1800s", script="set -euo pipefail; rtk pnpm --dir '{{ inputs.control_root|default('__required_control__') }}/tooling/brain-factory' exec tsx src/hydrate-integration-dependencies.mts --workdir '{{ inputs.workdir|default('__required_workdir__') }}' --base '{{ inputs.base_sha|default('__required_base__') }}'"]
  review [label="Read-Only Wave Review", max_visits=4, timeout="7200s", prompt="For structured evidence, use rtk proxy git for every SHA, path, status, numstat, or cherry value used as structured evidence; filtered rtk git output must never feed structured evidence. Do not use native apply_patch; use one guarded targeted shell or write_file edit and inspect git diff immediately. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifacts. Perform a read-only independent semantic review of immutable wave {{ inputs.integration_id|default('__required_id__') }} in {{ inputs.workdir|default('__required_workdir__') }} against {{ inputs.selection_path|default('__required_selection__') }}, every selected task packet, and proofs under {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/. The deterministic apply node exclusively owns selection validation, lane application, dependency hydration before generation, codegen, generated-file stability, and focused checks; never repeat or replace that work with an LLM integration pass. Ignore every prior broad-gate receipt status and finding during semantic review; leave that evidence unchanged. The deterministic gates node exclusively owns broad-gate execution and its verdict. Never edit or commit worktree/product files and never certify a repair authored in this review turn. You may write only {{ inputs.evidence_dir|default('__required_evidence__') }}/integration/{{ inputs.integration_id|default('__required_id__') }}/integration-result.json. Preserve schemaVersion maestro-brain-integration-result/v3 and every integration-produced field, including selectionPayloadSha256 {{ inputs.selection_payload_sha256|default('__required_payload_hash__') }} and selectionFileSha256 {{ inputs.selection_file_sha256|default('__required_file_hash__') }}; mutate only reviewVerdict, remainingFindings, and resolvedFindings. Preserve status ready_for_review through this review; status passed belongs only to the record node after the broad gate, and reviewed is not a valid status. Before record, selected lane results must remain status lane_green until the record node transitions them; do not require integrationId or integrationHeadSha to match this wave yet. Do not run integration-result-check.mts or validateIntegratedLanes before record; those final checks belong only to post_record after record has transitioned the selected lanes. When immutable selection laneResultSha256, proofSha256, gateSha256, taskBlockHash, and lane head all match, prior superseded integration overlay metadata is provenance, not a blocker. Verify exact task-set binding, base-only dependencies with no same-wave edges, patch ownership, generated-only integration files, tenant and lifecycle boundaries, typed errors, honest tests, and 300-line hand-authored commit budgets. The canonical budget evidence is each selected lane's exact-head final lane-gate sourceSlices calculated by the factory; do not recompute budgets from integration cherry-pick commit numstat and do not count test lines as source lines. Run focused read-only checks only. On a defect set reviewVerdict rework and stable-ID remainingFindings; otherwise bind reviewVerdict pass and remainingFindings empty to exact HEAD and both immutable selection hashes. Never claim acceptance evidence that is unavailable."]
  review_gate [shape=parallelogram, goal_gate=true, retry_target=repair, timeout="600s", script="set -euo pipefail; WORKDIR='{{ inputs.workdir|default('__required_workdir__') }}'; EVIDENCE='{{ inputs.evidence_dir|default('__required_evidence__') }}'; ID='{{ inputs.integration_id|default('__required_id__') }}'; PAYLOAD_HASH='{{ inputs.selection_payload_sha256|default('__required_payload_hash__') }}'; FILE_HASH='{{ inputs.selection_file_sha256|default('__required_file_hash__') }}'; HEAD_SHA=$(cd \"$WORKDIR\" && rtk proxy git rev-parse HEAD); RESULT=\"$EVIDENCE/integration/$ID/integration-result.json\"; rtk proxy jq -e --arg head \"$HEAD_SHA\" --arg id \"$ID\" --arg payload \"$PAYLOAD_HASH\" --arg file \"$FILE_HASH\" '.schemaVersion == \"maestro-brain-integration-result/v3\" and .status == \"ready_for_review\" and .reviewVerdict == \"pass\" and .headSha == $head and .integrationId == $id and .selectionPayloadSha256 == $payload and .selectionFileSha256 == $file and ((.remainingFindings // []) | length == 0)' \"$RESULT\"; STATUS=$(cd \"$WORKDIR\" && rtk proxy git status --porcelain); rtk proxy test -z \"$STATUS\""]
  repair [label="Repair Exact Wave Head", max_visits=2, timeout="10800s", prompt="For structured evidence, use rtk proxy git for every SHA, path, status, numstat, or cherry value used as structured evidence; filtered rtk git output must never feed structured evidence. Do not use native apply_patch; use one guarded targeted shell or write_file edit and inspect git diff immediately. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifacts. Repair only immutable wave {{ inputs.integration_id|default('__required_id__') }} in {{ inputs.workdir|default('__required_workdir__') }} against semantic findings in {{ inputs.evidence_dir|default('__required_evidence__') }}/integration/{{ inputs.integration_id|default('__required_id__') }}/integration-result.json and selected task proofs under {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/. Do not reselect or cherry-pick task lanes, reset history, mutate the control checkout, or touch a task worktree. Integration-only changes are limited to generated output. Never edit hand-authored product code or tests in this node; if a finding requires either, preserve a stable rework finding that identifies the owning task lane and return without attempting the change. Fabro counts the initial node entry as one visit, so max_visits two permits exactly one repair attempt and then terminates repeated unchanged rework. Run focused checks only, preserve both immutable selection hashes, update remaining/resolved findings and exact HEAD without self-certifying reviewVerdict pass, and leave the worktree clean. "]
  gates [shape=parallelogram, goal_gate=true, retry_target=repair, timeout="10800s", script="set -euo pipefail; WORKDIR='{{ inputs.workdir|default('__required_workdir__') }}'; CONTROL='{{ inputs.control_root|default('__required_control__') }}'; EVIDENCE='{{ inputs.evidence_dir|default('__required_evidence__') }}'; ID='{{ inputs.integration_id|default('__required_id__') }}'; rtk pnpm --dir \"$CONTROL/tooling/brain-factory\" exec tsx src/integration-broad-gate.mts --workdir \"$WORKDIR\" --evidence \"$EVIDENCE\" --integration-id \"$ID\"; cd \"$WORKDIR\"; rtk git diff --check; STATUS=$(rtk proxy git status --porcelain); rtk proxy test -z \"$STATUS\""]
  record [label="Record Passed Wave", max_visits=2, timeout="1800s", prompt="For structured evidence, use rtk proxy git for every SHA, path, status, numstat, or cherry value used as structured evidence; filtered rtk git output must never feed structured evidence. Do not use native apply_patch; use one guarded targeted shell or write_file edit and inspect git diff immediately. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifacts. The one full gate passed for immutable wave {{ inputs.integration_id|default('__required_id__') }}. Mutate only {{ inputs.evidence_dir|default('__required_evidence__') }}/integration/{{ inputs.integration_id|default('__required_id__') }}/integration-result.json and selected records under {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/; never mutate product files, control, or task worktrees. Record schemaVersion maestro-brain-integration-result/v3, exact baseSha and headSha, integrationWorkdir exactly {{ inputs.workdir|default('__required_workdir__') }}, selectionPayloadSha256 {{ inputs.selection_payload_sha256|default('__required_payload_hash__') }}, selectionFileSha256 {{ inputs.selection_file_sha256|default('__required_file_hash__') }}, sorted manifestTranches, includedTasks in immutable selectedTasks order with their true task-level tranches and exact laneHeadSha, exact generatedFiles, reviewVerdict pass, remainingFindings empty, status passed, and broadGate equal to the exact schemaVersion, status, headSha, command, and attempts from the head-bound broad-gate-HEAD.json sidecar. Do not omit, synthesize, or reorder its attempt receipts. The required field name is integrationWorkdir, not workdir. For every included lane preserve proof/head data, copy the immutable selection's laneResultSha256 to preIntegrationLaneResultSha256, and set integrationId and integrationHeadSha. When no original acceptanceAfter evidence proves accepted:true, set lane status integrated whenever accepted:false and record a non-empty acceptanceBlocker. Set lane status accepted only when original acceptanceAfter evidence proves accepted:true. Remove acceptedBecause whenever accepted:false; acceptedBecause may exist only with accepted:true and status accepted. Never fabricate acceptance evidence. Leave the worktree clean."]
  post_record [shape=parallelogram, goal_gate=true, retry_target=record, max_retries=1, timeout="600s", script="set -euo pipefail; rtk pnpm --dir '{{ inputs.control_root|default('__required_control__') }}/tooling/brain-factory' exec tsx src/integration-result-check.mts --control-root '{{ inputs.control_root|default('__required_control__') }}' --workdir '{{ inputs.workdir|default('__required_workdir__') }}' --evidence '{{ inputs.evidence_dir|default('__required_evidence__') }}' --integration-id '{{ inputs.integration_id|default('__required_id__') }}' --wave-selection '{{ inputs.selection_path|default('__required_selection__') }}' --adopt-legacy-evidence"]
  start -> preflight
  preflight -> apply_integration_wave [condition="outcome=succeeded"]
  preflight -> exit [label="blocked"]
  apply_integration_wave -> dependencies [condition="outcome=succeeded"]
  apply_integration_wave -> exit [label="apply red"]
  dependencies -> review [condition="outcome=succeeded"]
  dependencies -> repair [label="install red"]
  review -> review_gate
  review_gate -> gates [condition="outcome=succeeded"]
  review_gate -> repair [label="rework"]
  repair -> dependencies
  gates -> record [condition="outcome=succeeded"]
  gates -> repair [label="red"]
  record -> post_record
  post_record -> exit [condition="outcome=succeeded"]
  post_record -> record [label="record invalid"]
}
