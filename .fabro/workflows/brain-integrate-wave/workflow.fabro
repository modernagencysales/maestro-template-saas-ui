digraph BrainIntegrateWave {
  graph [
    goal="Integrate one immutable, dependency-safe cross-tranche Maestro Brain wave and prove its exact head",
    inputs="workdir,control_root,evidence_dir,integration_id,base_sha,selection_path,selection_sha256,mode,attempt,reservation_token",
    model_stylesheet="
      #integrate { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
      #review    { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
    ",
    rankdir=LR
  ]
  start [shape=Mdiamond]
  exit [shape=Msquare]
  preflight [shape=parallelogram, goal_gate=true, retry_target=preflight, max_retries=1, timeout="600s", script="set -euo pipefail; WORKDIR='{{ inputs.workdir|default('__required_workdir__') }}'; CONTROL='{{ inputs.control_root|default('__required_control__') }}'; EVIDENCE='{{ inputs.evidence_dir|default('__required_evidence__') }}'; ID='{{ inputs.integration_id|default('__required_id__') }}'; BASE='{{ inputs.base_sha|default('__required_base__') }}'; SELECTION='{{ inputs.selection_path|default('__required_selection__') }}'; HASH='{{ inputs.selection_sha256|default('__required_hash__') }}'; MODE='{{ inputs.mode|default('integrate') }}'; rtk proxy test \"${WORKDIR#/}\" != \"$WORKDIR\"; rtk proxy test \"${CONTROL#/}\" != \"$CONTROL\"; rtk proxy test \"${EVIDENCE#/}\" != \"$EVIDENCE\"; rtk proxy test -s \"$SELECTION\"; rtk proxy test \"$MODE\" = integrate -o \"$MODE\" = recover; rtk pnpm --dir \"$CONTROL/tooling/brain-factory\" exec tsx src/integration-wave-selection-check.mts --selection \"$SELECTION\" --integration-id \"$ID\" --base \"$BASE\" --selection-sha256 \"$HASH\"; rtk proxy mkdir -p \"$EVIDENCE/integration/$ID\"; if [ \"$MODE\" = integrate ]; then rtk proxy test \"$(cd \"$WORKDIR\" && rtk proxy git rev-parse HEAD)\" = \"$BASE\"; fi"]
  integrate [label="Integrate Immutable Wave", max_visits=4, timeout="10800s", prompt="For structured evidence, use rtk proxy git for every SHA, path, status, numstat, or cherry value used as structured evidence; filtered rtk git output must never feed structured evidence. Do not use native apply_patch; use one guarded targeted shell or write_file edit and inspect git diff immediately. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifacts. Integrate immutable wave {{ inputs.integration_id|default('__required_id__') }} in {{ inputs.workdir|default('__required_workdir__') }} from exact base {{ inputs.base_sha|default('__required_base__') }} using only selectedTasks in {{ inputs.selection_path|default('__required_selection__') }}, whose hash is {{ inputs.selection_sha256|default('__required_hash__') }}. Read lane proofs only under {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/. Never discover or add a late lane. In integrate mode, cherry-pick every selected lane's complete base..head commit range in deterministic selectedTasks order and reject conflicts or drift. In recover mode, preserve existing commits and idempotently inspect every selected lane range with git cherry; cherry-pick only complete patch ranges proven missing, never duplicate an already-applied patch, then repair only recorded findings or failed gate output for this exact selection. Before every mutation verify the target is inside the integration workdir; never mutate the control checkout or task worktrees. Run centralized Confect, Convex, manifest, and route codegen at most once after all source commits, and keep every non-lane changed file limited to integration-owned generated output. Generated output gets a separate integration commit. Every hand-authored commit must change at most 300 source lines. Run focused checks only; the gates node owns the sole broad verify. Write or update only {{ inputs.evidence_dir|default('__required_evidence__') }}/integration/{{ inputs.integration_id|default('__required_id__') }}/integration-result.json with schema v2, exact selection identity, included tasks in selectedTasks order with task-level tranches and exact laneHeadSha provenance, generatedFiles, exact head, and status ready_for_review.  Leave the worktree clean."]
  dependencies [shape=parallelogram, goal_gate=true, retry_target=repair, timeout="1800s", script="set -euo pipefail; rtk pnpm --dir '{{ inputs.control_root|default('__required_control__') }}/tooling/brain-factory' exec tsx src/hydrate-integration-dependencies.mts --workdir '{{ inputs.workdir|default('__required_workdir__') }}' --base '{{ inputs.base_sha|default('__required_base__') }}'"]
  review [label="Read-Only Wave Review", max_visits=4, timeout="7200s", prompt="For structured evidence, use rtk proxy git for every SHA, path, status, numstat, or cherry value used as structured evidence; filtered rtk git output must never feed structured evidence. Do not use native apply_patch; use one guarded targeted shell or write_file edit and inspect git diff immediately. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifacts. Perform a read-only independent review of immutable wave {{ inputs.integration_id|default('__required_id__') }} in {{ inputs.workdir|default('__required_workdir__') }} against {{ inputs.selection_path|default('__required_selection__') }}, every selected task packet, and proofs under {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/. Never edit or commit worktree/product files and never certify a repair authored in this review turn. You may write only {{ inputs.evidence_dir|default('__required_evidence__') }}/integration/{{ inputs.integration_id|default('__required_id__') }}/integration-result.json. Preserve status ready_for_review through this review; status passed belongs only to the record node after the broad gate, and reviewed is not a valid status. Verify exact task-set binding, base-only dependencies with no same-wave edges, patch ownership, generated-only integration files, tenant and lifecycle boundaries, typed errors, honest tests, and 300-line hand-authored commit budgets. Run focused read-only checks only. On a defect set reviewVerdict rework and stable-ID remainingFindings; otherwise bind reviewVerdict pass and remainingFindings empty to exact HEAD and selection hash. Never claim acceptance evidence that is unavailable."]
  review_gate [shape=parallelogram, goal_gate=true, retry_target=repair, timeout="600s", script="set -euo pipefail; WORKDIR='{{ inputs.workdir|default('__required_workdir__') }}'; EVIDENCE='{{ inputs.evidence_dir|default('__required_evidence__') }}'; ID='{{ inputs.integration_id|default('__required_id__') }}'; HASH='{{ inputs.selection_sha256|default('__required_hash__') }}'; HEAD_SHA=$(cd \"$WORKDIR\" && rtk proxy git rev-parse HEAD); RESULT=\"$EVIDENCE/integration/$ID/integration-result.json\"; rtk proxy jq -e --arg head \"$HEAD_SHA\" --arg id \"$ID\" --arg hash \"$HASH\" '.schemaVersion == \"maestro-brain-integration-result/v2\" and .status == \"ready_for_review\" and .reviewVerdict == \"pass\" and .headSha == $head and .integrationId == $id and .selectionSha256 == $hash and ((.remainingFindings // []) | length == 0)' \"$RESULT\"; STATUS=$(cd \"$WORKDIR\" && rtk proxy git status --porcelain); rtk proxy test -z \"$STATUS\""]
  repair [label="Repair Exact Wave Head", max_visits=4, timeout="10800s", prompt="For structured evidence, use rtk proxy git for every SHA, path, status, numstat, or cherry value used as structured evidence; filtered rtk git output must never feed structured evidence. Do not use native apply_patch; use one guarded targeted shell or write_file edit and inspect git diff immediately. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifacts. Repair only immutable wave {{ inputs.integration_id|default('__required_id__') }} in {{ inputs.workdir|default('__required_workdir__') }} against findings in {{ inputs.evidence_dir|default('__required_evidence__') }}/integration/{{ inputs.integration_id|default('__required_id__') }}/integration-result.json and selected task proofs under {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/. Do not reselect or cherry-pick task lanes, reset history, mutate the control checkout, or touch a task worktree. Add honest negative tests first, keep each hand-authored commit at or below 300 changed source lines, and allow integration-only changes solely in generated output. Run focused checks only, update remaining/resolved findings and exact HEAD without self-certifying reviewVerdict pass, and leave the worktree clean. "]
  gates [shape=parallelogram, goal_gate=true, retry_target=repair, timeout="10800s", script="set -euo pipefail; cd '{{ inputs.workdir|default('__required_workdir__') }}'; rtk host-test-slot --class full pnpm verify; rtk git diff --check; STATUS=$(rtk proxy git status --porcelain); rtk proxy test -z \"$STATUS\""]
  record [label="Record Passed Wave", max_visits=2, timeout="1800s", prompt="For structured evidence, use rtk proxy git for every SHA, path, status, numstat, or cherry value used as structured evidence; filtered rtk git output must never feed structured evidence. Do not use native apply_patch; use one guarded targeted shell or write_file edit and inspect git diff immediately. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifacts. The one full gate passed for immutable wave {{ inputs.integration_id|default('__required_id__') }}. Mutate only {{ inputs.evidence_dir|default('__required_evidence__') }}/integration/{{ inputs.integration_id|default('__required_id__') }}/integration-result.json and selected records under {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/; never mutate product files, control, or task worktrees. Record schemaVersion maestro-brain-integration-result/v2, exact baseSha and headSha, integrationWorkdir exactly {{ inputs.workdir|default('__required_workdir__') }}, selectionSha256 {{ inputs.selection_sha256|default('__required_hash__') }}, sorted manifestTranches, includedTasks in immutable selectedTasks order with their true task-level tranches and exact laneHeadSha, exact generatedFiles, reviewVerdict pass, remainingFindings empty, status passed, and broadGate { status: passed, headSha: HEAD, command: rtk host-test-slot --class full pnpm verify }. The required field name is integrationWorkdir, not workdir. For every included lane preserve proof/head data, copy the immutable selection's laneResultSha256 to preIntegrationLaneResultSha256, set integrationId and integrationHeadSha, and record accepted:false plus a non-empty acceptanceBlocker unless original acceptanceAfter evidence already proves accepted:true. Remove acceptedBecause whenever accepted:false; acceptedBecause may exist only with accepted:true and status accepted. Never fabricate acceptance evidence.  Leave the worktree clean."]
  post_record [shape=parallelogram, goal_gate=true, retry_target=record, max_retries=1, timeout="600s", script="set -euo pipefail; rtk pnpm --dir '{{ inputs.control_root|default('__required_control__') }}/tooling/brain-factory' exec tsx src/integration-result-check.mts --control-root '{{ inputs.control_root|default('__required_control__') }}' --workdir '{{ inputs.workdir|default('__required_workdir__') }}' --evidence '{{ inputs.evidence_dir|default('__required_evidence__') }}' --integration-id '{{ inputs.integration_id|default('__required_id__') }}' --wave-selection '{{ inputs.selection_path|default('__required_selection__') }}' --adopt-legacy-evidence"]
  start -> preflight
  preflight -> integrate [condition="outcome=succeeded"]
  preflight -> exit [label="blocked"]
  integrate -> dependencies
  dependencies -> review [condition="outcome=succeeded"]
  dependencies -> repair [label="install red"]
  review -> review_gate
  review_gate -> gates [condition="outcome=succeeded"]
  review_gate -> repair [label="rework"]
  repair -> dependencies
  gates -> record [condition="outcome=succeeded"]
  gates -> repair [label="red"]
  record -> post_record
  post_record -> exit [condition="outcome=succeeded"]
  post_record -> record [label="record invalid"]
}
