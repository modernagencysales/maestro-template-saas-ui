digraph BrainIntegrateTranche {
  graph [
    goal="Integrate one dependency-safe Maestro Brain tranche and prove the combined head",
    inputs="workdir,control_root,evidence_dir,tranche,manifest_tranche,integration_id,base_sha",
    model_stylesheet="
      #integrate { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
      #review    { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
    ",
    rankdir=LR
  ]
  start [shape=Mdiamond]
  exit [shape=Msquare]
  preflight [shape=parallelogram, goal_gate=true, retry_target=preflight, max_retries=1, timeout="600s", script="set -euo pipefail; WORKDIR='{{ inputs.workdir|default('__required_workdir__') }}'; EVIDENCE='{{ inputs.evidence_dir|default('__required_evidence__') }}'; MANIFEST='{{ inputs.manifest_tranche|default('__required_manifest_tranche__') }}'; INTEGRATION='{{ inputs.integration_id|default('__required_integration_id__') }}'; rtk proxy test \"${WORKDIR#/}\" != \"$WORKDIR\"; rtk proxy test \"${EVIDENCE#/}\" != \"$EVIDENCE\"; rtk proxy test -n \"$MANIFEST\"; rtk proxy test -n \"$INTEGRATION\"; cd \"$WORKDIR\"; rtk proxy test -s docs/superpowers/execution/maestro-brain/task-manifest.json; rtk proxy test -d \"$EVIDENCE/lane-results\"; rtk proxy mkdir -p \"$EVIDENCE/integration/$INTEGRATION\""]
  integrate [label="Integrate Green Lanes", max_visits=4, timeout="10800s", prompt="For structured evidence, use rtk proxy git for every SHA, path, status, numstat, or cherry value used as structured evidence; filtered rtk git output must never feed structured evidence. Do not use native apply_patch; use one guarded targeted shell or write_file edit and inspect git diff immediately. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifacts. Integrate manifest tranche {{ inputs.manifest_tranche|default('__required_manifest_tranche__') }} as uniquely owned attempt {{ inputs.integration_id|default('__required_integration_id__') }} in {{ inputs.workdir|default('__required_workdir__') }} from exact base {{ inputs.base_sha|default('__required_base__') }}. Read the root AGENTS.md by its exact path and never glob node_modules or the whole worktree to find instruction files. Before every mutating tool call, verify the target is under the exact integration workdir; never edit, reset, clean, remove, or otherwise mutate the control checkout or a task worktree. The only allowed integration evidence write is {{ inputs.evidence_dir|default('__required_evidence__') }}/integration/{{ inputs.integration_id|default('__required_integration_id__') }}/integration-result.json; included lane evidence is read from {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/. Report accidental cross-worktree changes instead of cleaning them. Read the task manifest and only select lane-result.json entries whose manifest tranche is {{ inputs.manifest_tranche|default('__required_manifest_tranche__') }}, status is lane_green, final lane gate passed, proof/head hashes match, codeStartAfter dependencies are present on the base or this integration head, and ownership does not conflict. Cherry-pick each one-intention task commit in deterministic topological/task-ID order. Reject drift or send a conflict back to the owning task; do not silently blend two owners. After all cherry-picks, run centralized Confect/Convex/route codegen at most once whenever the combined source makes generated output stale. Appendix P assigns that generated diff to tranche integration even when no isolated task owns @generated-confect; commit and record the exact generated files separately. Update subsystem status docs in the owning commit or add a narrow integration commit. Do not weaken tests or gates. Run only focused combined checks in this agent node; do not run broad verify because the deterministic gates node owns the single full verification. Produce the draft integration result with baseSha, manifestTranche, integrationId, included tasks, commits, generated diffs, conflicts, and status ready_for_review. If native apply_patch fails once, stop using it, switch to a targeted shell or write_file edit, and immediately inspect git diff."]
  review [label="Read-Only Cross-Domain Review", max_visits=4, timeout="5400s", prompt="For structured evidence, use rtk proxy git for every SHA, path, status, numstat, or cherry value used as structured evidence; filtered rtk git output must never feed structured evidence. Do not use native apply_patch; use one guarded targeted shell or write_file edit and inspect git diff immediately. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifacts. Perform a read-only review of integration attempt {{ inputs.integration_id|default('__required_integration_id__') }} for manifest tranche {{ inputs.manifest_tranche|default('__required_manifest_tranche__') }} against every included task packet and proof under {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/. Never edit or commit product/worktree files and never certify a repair authored in this review turn. The only allowed write is {{ inputs.evidence_dir|default('__required_evidence__') }}/integration/{{ inputs.integration_id|default('__required_integration_id__') }}/integration-result.json. Check cross-lane contract compatibility, generated refs, tenant isolation, lifecycle monotonicity, provider boundaries, typed errors, test honesty, and shared-file ownership. Run only focused read-only checks; do not run broad verify. Bind the review to exact HEAD and integration identities. On any defect set reviewVerdict rework and append stable-ID remainingFindings; otherwise set reviewVerdict pass, exact headSha, and remainingFindings empty. Do not claim tasks accepted yet."]
  review_gate [shape=parallelogram, goal_gate=true, retry_target=repair, timeout="600s", script="set -euo pipefail; WORKDIR='{{ inputs.workdir|default('.') }}'; EVIDENCE='{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}'; MANIFEST='{{ inputs.manifest_tranche|default('') }}'; LEGACY='{{ inputs.tranche|default('C1-contract-spine') }}'; INTEGRATION='{{ inputs.integration_id|default('') }}'; if [ -z \"$MANIFEST\" ]; then MANIFEST=\"$LEGACY\"; fi; if [ -z \"$INTEGRATION\" ]; then INTEGRATION=\"$MANIFEST\"; fi; HEAD_SHA=$(cd \"$WORKDIR\" && rtk proxy git rev-parse HEAD); RESULT=\"$EVIDENCE/integration/$INTEGRATION/integration-result.json\"; rtk proxy jq -e --arg head \"$HEAD_SHA\" --arg id \"$INTEGRATION\" --arg tranche \"$MANIFEST\" '.reviewVerdict == \"pass\" and .headSha == $head and .integrationId == $id and .manifestTranche == $tranche and ((.remainingFindings // []) | length == 0)' \"$RESULT\"; STATUS=$(cd \"$WORKDIR\" && rtk proxy git status --porcelain); rtk proxy test -z \"$STATUS\""]
  repair [label="Repair Exact Integration Head", max_visits=4, timeout="10800s", prompt="For structured evidence, use rtk proxy git for every SHA, path, status, numstat, or cherry value used as structured evidence; filtered rtk git output must never feed structured evidence. Do not use native apply_patch; use one guarded targeted shell or write_file edit and inspect git diff immediately. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifact. Repair only the already-integrated attempt {{ inputs.integration_id|default('__required_integration_id__') }} in the exact workdir {{ inputs.workdir|default('__required_workdir__') }}. Do not select or cherry-pick task lanes again, reset history, or mutate the control checkout/task worktrees. Read failed gate output and stable-ID review findings from {{ inputs.evidence_dir|default('__required_evidence__') }}/integration/{{ inputs.integration_id|default('__required_integration_id__') }}/integration-result.json. Add honest negative tests first, make coherent commits of at most 300 changed hand-authored source lines, preserve tenant/lifecycle/provider/generated boundaries, and run focused checks only. Update only that exact integration result with exact HEAD, resolvedFindings, and any remainingFindings; never self-certify reviewVerdict pass. If native apply_patch fails once, switch to a targeted edit and inspect git diff immediately."]
  gates [shape=parallelogram, goal_gate=true, retry_target=repair, timeout="10800s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; rtk host-test-slot --class full pnpm verify; rtk git diff --check; STATUS=$(rtk proxy git status --porcelain); rtk proxy test -z \"$STATUS\""]
  record [label="Record Integration", timeout="1800s", prompt="For structured evidence, use rtk proxy git for every SHA, path, status, numstat, or cherry value used as structured evidence; filtered rtk git output must never feed structured evidence. Do not use native apply_patch; use one guarded targeted shell or write_file edit and inspect git diff immediately. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifacts. The full gate passed for integration attempt {{ inputs.integration_id|default('__required_integration_id__') }} of manifest tranche {{ inputs.manifest_tranche|default('__required_manifest_tranche__') }}. Mutate only the exact integration workdir, {{ inputs.evidence_dir|default('__required_evidence__') }}/integration/{{ inputs.integration_id|default('__required_integration_id__') }}/integration-result.json, and included records under {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/; never touch the control checkout or task worktrees. Update the integration result with schemaVersion maestro-brain-integration-result/v1, baseSha {{ inputs.base_sha|default('__required_base__') }}, manifestTranche, integrationId, integrationWorkdir, exact headSha, reviewVerdict pass, status passed, and the exact broad gate receipt. For every included task, record tranche, integrationId, and integrationHeadSha without changing its proof. acceptanceAfter gates accepted:true only, never integration: if acceptance is proven, set status accepted and accepted:true; otherwise set status integrated, accepted:false, and a non-empty acceptanceBlocker that preserves unavailable external evidence. Remove acceptedBecause whenever accepted:false; acceptedBecause may exist only with accepted:true and status accepted. Legacy or mixed records must be migrated and re-proved; never fabricate acceptance evidence. If native apply_patch fails once, stop using it and use a targeted write_file or shell edit. Leave the integration worktree clean."]
  post_record [shape=parallelogram, goal_gate=true, retry_target=record, max_retries=1, timeout="600s", script="set -euo pipefail; WORKDIR='{{ inputs.workdir|default('.') }}'; CONTROL='{{ inputs.control_root|default('.') }}'; EVIDENCE='{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}'; MANIFEST='{{ inputs.manifest_tranche|default('') }}'; LEGACY='{{ inputs.tranche|default('C1-contract-spine') }}'; INTEGRATION='{{ inputs.integration_id|default('') }}'; if [ -z \"$MANIFEST\" ]; then MANIFEST=\"$LEGACY\"; fi; if [ -z \"$INTEGRATION\" ]; then INTEGRATION=\"$MANIFEST\"; fi; rtk pnpm --dir \"$CONTROL/tooling/brain-factory\" exec tsx src/integration-result-check.mts --control-root \"$CONTROL\" --workdir \"$WORKDIR\" --evidence \"$EVIDENCE\" --manifest-tranche \"$MANIFEST\" --integration-id \"$INTEGRATION\""]
  start -> preflight
  preflight -> integrate [condition="outcome=succeeded"]
  preflight -> exit [label="blocked"]
  integrate -> review -> review_gate
  review_gate -> gates [condition="outcome=succeeded"]
  review_gate -> repair [label="rework"]
  repair -> review
  gates -> record [condition="outcome=succeeded"]
  gates -> repair [label="red"]
  record -> post_record
  post_record -> exit [condition="outcome=succeeded"]
  post_record -> record [label="record invalid"]
}
