digraph BrainBuildTask {
  graph [
    goal="Implement one approved Maestro Brain task with test-first focused proof",
    inputs="workdir,evidence_dir,task_id,base_sha,start_sha,resume_mode,resume_source_head,resume_task_base,resume_commits,reproof_request,host_test_max_load_1m",
    model_stylesheet="
      #implement { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
      #review_contract { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
      #review_safety   { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
      #review_quality  { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
    ",
    rankdir=LR
  ]
  start [shape=Mdiamond]
  exit [shape=Msquare]

  preflight [shape=parallelogram, goal_gate=true, retry_target=preflight, max_retries=1, timeout="600s", script="set -euo pipefail; rtk proxy test \"${BRAIN_WORKDIR#/}\" != \"$BRAIN_WORKDIR\"; rtk proxy test \"${BRAIN_EVIDENCE_DIR#/}\" != \"$BRAIN_EVIDENCE_DIR\"; rtk proxy test \"$BRAIN_TASK_ID\" != \"${BRAIN_TASK_ID#S??-T??}\"; cd \"$BRAIN_WORKDIR\"; rtk proxy test -n \"$BRAIN_START_SHA\"; rtk proxy test -s docs/superpowers/execution/maestro-brain/task-manifest.json; rtk proxy test -s docs/superpowers/plans/2026-07-14-maestro-brain-agency-context-os-implementation-plan.md; rtk proxy mkdir -p \"$BRAIN_EVIDENCE_DIR/lane-results/$BRAIN_TASK_ID\"; STATUS=$(rtk proxy git status --porcelain); rtk proxy test -z \"$STATUS\"; rtk proxy test \"$(rtk proxy git rev-parse HEAD)\" = \"$BRAIN_START_SHA\""]

  apply_archive [shape=parallelogram, goal_gate=true, retry_target=apply_archive, max_retries=1, timeout="600s", script="set -euo pipefail; if [ \"$BRAIN_RESUME_MODE\" = none ]; then exit 0; fi; rtk proxy test \"$BRAIN_RESUME_MODE\" = conflict-aware; cd \"$BRAIN_WORKDIR\"; rtk proxy test \"$(rtk proxy git rev-parse HEAD)\" = \"$BRAIN_START_SHA\"; rtk proxy git cat-file -e \"$BRAIN_RESUME_SOURCE_HEAD^{commit}\"; rtk proxy git cat-file -e \"$BRAIN_RESUME_TASK_BASE^{commit}\"; rtk proxy git merge-base --is-ancestor \"$BRAIN_RESUME_TASK_BASE\" \"$BRAIN_RESUME_SOURCE_HEAD\"; OLD_IFS=$IFS; IFS=','; set -- $BRAIN_RESUME_COMMITS; IFS=$OLD_IFS; rtk proxy test \"$#\" -gt 0; for COMMIT in \"$@\"; do rtk proxy git cat-file -e \"$COMMIT^{commit}\"; done; if ! rtk proxy git cherry-pick \"$@\"; then rtk proxy git status --short; exit 0; fi"]

  implement [label="Implement Task", max_visits=10, timeout="10800s", prompt="Before contract reading or edits, run rtk proxy git status --short. If an archived resume cherry-pick is in progress, resolve it as the task owner, preserve the archived intent, change only files within declared task ownership, and run rtk proxy git cherry-pick --continue until the pinned sequence is complete; if resolution requires an out-of-scope file, stop and report a contract gap. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifact. Implement only task {{ inputs.task_id|default('__required_task__') }} in {{ inputs.workdir|default('__required_workdir__') }}. Read the root AGENTS.md by its exact path, the Parallel Execution Amendment and Appendices O/P, this task's complete packet in docs/superpowers/plans/2026-07-14-maestro-brain-agency-context-os-implementation-plan.md, its entry in docs/superpowers/execution/maestro-brain/task-manifest.json, every named playbook/anchor required by its classification, and only directly relevant source or vendored examples. Contract reading is not reconnaissance and is never skipped. After those required reads, make at most one scoped inventory pass per declared file-lock root and one exact-symbol or named-reference lookup per required seam. Do not repeat equivalent searches, compare alternative architectures, or re-investigate decisions fixed by the packet. Begin the first focused test edit once the target file, closest repository pattern, and focused command are known; if any remains unknown after the bounded pass, report a contract or template gap instead of widening the search. Never glob node_modules or the whole worktree to find instruction files. Do not repeat global product research. Before every edit or mutating shell command, verify the target is under the exact task workdir; use rtk proxy test for shell guards, never rtk test. Never invoke rtk python; use the native write_file tool, or rtk proxy python3 only when a script is truly necessary. Never edit, reset, clean, remove, or otherwise mutate the control checkout or any sibling worktree. The only allowed evidence write is {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/{{ inputs.task_id|default('__required_task__') }}/ci-proof-packet.json. Report accidental cross-worktree changes instead of cleaning them. Respect codeStartAfter as code-start authority and the original packet dependency as acceptance authority. If the branch already contains this task's implementation, review and repair it instead of duplicating it. Compare the complete task diff from {{ inputs.base_sha|default('__required_base__') }}; when one task commit exceeds 300 changed hand-authored source lines, rewrite only the task's unintegrated history into coherent intention commits up to sourceSliceLimit from the task manifest, defaulting to four; honor an explicit expanded task limit when the manifest declares one. Every commit remains within the slice budget. Before every proof handoff, count the complete {{ inputs.base_sha|default('__required_base__') }}..HEAD task history; after any repair, if it exceeds the manifest sourceSliceLimit, mechanically rewrite only that unintegrated history into one to that limit before leaving implementation. A history rewrite must distribute real content across every intention commit: never create empty padding commits or use --allow-empty, and verify each commit with the factory's exact gate-counted source-line calculation before proof. Edit only declared files or stop and amend the task contract. Never edit generated files unless this task owns @generated-confect. Use fake/local providers by default. Write the new behavior's focused tests before its implementation and preserve typed errors, tenant isolation, lifecycle fencing, redaction, and the repository layer law. Use repo generators exactly when the packet is pattern-instance. Do not weaken gates, add unexplained suppressions, or implement another task. During implementation run only the smallest new or failing test needed to iterate. Do not invoke brain:factory:lane-gates yourself; the next deterministic workflow node owns the complete focused gate. Record every exact focused packet command for that node except broad just verify/verify-full, plus the relevant package-local lint/type/test commands. On a repair or archived resume, preserve focusedCommands exactly as declared by the existing proof and task contract; record newly run lint, typecheck, coverage, or diagnostic commands only as supplemental command results, never by adding them to focusedCommands. Broad verification belongs to tranche integration. Record focusedCommands as exact single-process commands beginning with rtk; do not record prose, output, shell chaining, quoting, or broad root test/typecheck/verify commands. Commit one to the manifest sourceSliceLimit coherent intentions with conventional subjects. Write the proof with schemaVersion='maestro-brain-ci-proof/v1', current planSha256/taskBlockHash, taskId, baseSha='{{ inputs.base_sha|default('__required_base__') }}', headSha, changedFiles, focusedCommands, testsAdded, reviewVerdict='pending', and knownRisks. Never invent or preserve stale plan/task hashes: a changed contract requires a new proof and gates. The proof head may precede only a byte-identical Fabro checkpoint and the worktree must be clean. Do not use native apply_patch in this Fabro lane; use only guarded targeted shell or write_file edits and inspect git diff immediately after every edit. Whenever Git output will be copied into or machine-parsed for the proof packet, including headSha, changedFiles, commit counts, or hashes, use rtk proxy git; filtered rtk git output is display-only and must never feed structured evidence."]

  gates [shape=parallelogram, goal_gate=true, retry_target=implement, timeout="5400s", script="set -euo pipefail; export HOST_TEST_MAX_LOAD_1M=\"$BRAIN_HOST_TEST_MAX_LOAD_1M\"; cd \"$BRAIN_WORKDIR\"; rtk proxy node --import tsx tooling/brain-factory/src/lane-gates.mts --task \"$BRAIN_TASK_ID\" --evidence \"$BRAIN_EVIDENCE_DIR\" --stage pre-review --reproof-request \"$BRAIN_REPROOF_REQUEST\""]

  review_snapshot [shape=parallelogram, goal_gate=true, retry_target=implement, timeout="300s", script="set -euo pipefail; cd \"$BRAIN_WORKDIR\"; REVIEW_HEAD=$(rtk proxy git rev-parse HEAD); rtk proxy node --import tsx tooling/brain-factory/src/review-worktree-guard.mts capture --workdir \"$BRAIN_WORKDIR\" --task \"$BRAIN_TASK_ID\" --evidence \"$BRAIN_EVIDENCE_DIR\"; rtk proxy node --import tsx tooling/brain-factory/src/review-worktrees.mts prepare --workdir \"$BRAIN_WORKDIR\" --evidence \"$BRAIN_EVIDENCE_DIR\" --task \"$BRAIN_TASK_ID\" --head \"$REVIEW_HEAD\" --attempt \"$BRAIN_REVIEW_ATTEMPT\""]

  review_fork [label="Parallel Exhaustive Review", shape=component, join_policy="wait_all", max_parallel=1]
  review_merge [label="Join Exhaustive Reviews", shape=tripleoctagon]

  review_contract [label="Exhaustive Contract Review", max_visits=10, timeout="5400s", prompt="Before any read or write, cd to the factory-owned contract review worktree: set REVIEW_HEAD from rtk proxy git -C \"$BRAIN_WORKDIR\" rev-parse HEAD, set REVIEW_WORKTREE from rtk proxy node --import tsx \"$BRAIN_WORKDIR/tooling/brain-factory/src/review-worktrees.mts\" path --workdir \"$BRAIN_WORKDIR\" --evidence \"$BRAIN_EVIDENCE_DIR\" --task \"$BRAIN_TASK_ID\" --head \"$REVIEW_HEAD\" --attempt \"$BRAIN_REVIEW_ATTEMPT\" --lens contract, then cd \"$REVIEW_WORKTREE\" and keep every tool cwd there. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifact. Independently review task {{ inputs.task_id|default('__required_task__') }} in {{ inputs.workdir|default('__required_workdir__') }} against its full task packet, design requirements, task-manifest ownership, AGENTS.md, tests, and the exact passed pre-review lane-gate report for the same head and task contract under {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/. Shared evidence is read-only throughout this branch. Semantic inspection of the tests and diff remains mandatory. Dispose every rubric item exactly once: contract.task-packet, contract.typed-api, contract.schema, contract.plan, contract.ownership, contract.failure-contract. Check task-packet acceptance, typed API and expected errors, durable schema invariants, work-package plan compliance, exact ownership, and every declared failure path. Use disposition pass, finding, or not_applicable with concrete evidence; not_applicable requires rationale and every finding requires a stable unique ID. Never edit the proof packet or any shared evidence. Never edit or commit product/worktree files. The only allowed write is .brain-review-output/contract.json in this factory-owned managed review worktree. Set reviewerRunId to the exact output of rtk proxy git branch --show-current. After writing it, run rtk proxy node --import tsx tooling/brain-factory/src/review-lens-guard.mts --lens contract; the trusted guard is mandatory, validates and commits only the branch-local artifact and delta, and writes nothing to shared evidence. Write the Task 1 ReviewLensArtifact schema with lens='contract', exact proof planSha256/taskBlockHash/baseSha/headSha, exact HEAD treeSha, reviewerRunId equal to the exact current isolated branch name, all rubricDispositions, all findings, and verdict derived from findings. planSha256 is retained provenance; any taskBlockHash drift is rework. Do not run tests or broad verify. Whenever Git output will be copied into or machine-parsed for the proof packet or lens artifact, use rtk proxy git; filtered rtk git output must never feed structured evidence."]

  review_safety [label="Exhaustive Safety Review", max_visits=10, timeout="5400s", prompt="Before any read or write, cd to the factory-owned safety review worktree: set REVIEW_HEAD from rtk proxy git -C \"$BRAIN_WORKDIR\" rev-parse HEAD, set REVIEW_WORKTREE from rtk proxy node --import tsx \"$BRAIN_WORKDIR/tooling/brain-factory/src/review-worktrees.mts\" path --workdir \"$BRAIN_WORKDIR\" --evidence \"$BRAIN_EVIDENCE_DIR\" --task \"$BRAIN_TASK_ID\" --head \"$REVIEW_HEAD\" --attempt \"$BRAIN_REVIEW_ATTEMPT\" --lens safety, then cd \"$REVIEW_WORKTREE\" and keep every tool cwd there. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifact. Independently review task {{ inputs.task_id|default('__required_task__') }} in {{ inputs.workdir|default('__required_workdir__') }} against its full task packet, design requirements, task-manifest ownership, AGENTS.md, tests, and the exact passed pre-review lane-gate report for the same head and task contract under {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/. Shared evidence is read-only throughout this branch. Semantic inspection of the tests and diff remains mandatory. Dispose every rubric item exactly once: safety.tenancy, safety.authorization, safety.lifecycle, safety.privacy, safety.concurrency, safety.replay, safety.fencing, safety.provider-boundaries. Check tenant isolation, authorization, lifecycle and tombstone behavior, privacy and redaction, concurrent stale-generation races, replay and idempotency, revision fencing, and provider/secret boundaries. Use disposition pass, finding, or not_applicable with concrete evidence; not_applicable requires rationale and every finding requires a stable unique ID. Never edit the proof packet or any shared evidence. Never edit or commit product/worktree files. The only allowed write is .brain-review-output/safety.json in this factory-owned managed review worktree. Set reviewerRunId to the exact output of rtk proxy git branch --show-current. After writing it, run rtk proxy node --import tsx tooling/brain-factory/src/review-lens-guard.mts --lens safety; the trusted guard is mandatory, validates and commits only the branch-local artifact and delta, and writes nothing to shared evidence. Write the Task 1 ReviewLensArtifact schema with lens='safety', exact proof planSha256/taskBlockHash/baseSha/headSha, exact HEAD treeSha, reviewerRunId equal to the exact current isolated branch name, all rubricDispositions, all findings, and verdict derived from findings. planSha256 is retained provenance; any taskBlockHash drift is rework. Do not run tests or broad verify. Whenever Git output will be copied into or machine-parsed for the proof packet or lens artifact, use rtk proxy git; filtered rtk git output must never feed structured evidence."]

  review_quality [label="Exhaustive Quality Review", max_visits=10, timeout="5400s", prompt="Before any read or write, cd to the factory-owned quality review worktree: set REVIEW_HEAD from rtk proxy git -C \"$BRAIN_WORKDIR\" rev-parse HEAD, set REVIEW_WORKTREE from rtk proxy node --import tsx \"$BRAIN_WORKDIR/tooling/brain-factory/src/review-worktrees.mts\" path --workdir \"$BRAIN_WORKDIR\" --evidence \"$BRAIN_EVIDENCE_DIR\" --task \"$BRAIN_TASK_ID\" --head \"$REVIEW_HEAD\" --attempt \"$BRAIN_REVIEW_ATTEMPT\" --lens quality, then cd \"$REVIEW_WORKTREE\" and keep every tool cwd there. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifact. Independently review task {{ inputs.task_id|default('__required_task__') }} in {{ inputs.workdir|default('__required_workdir__') }} against its full task packet, design requirements, task-manifest ownership, AGENTS.md, tests, and the exact passed pre-review lane-gate report for the same head and task contract under {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/. Shared evidence is read-only throughout this branch. Semantic inspection of the tests and diff remains mandatory. Dispose every rubric item exactly once: quality.test-adequacy, quality.layer-law, quality.maintainability, quality.observability, quality.budgets, quality.generated-file-discipline. Check false-green and missing-error tests, layer-law skips, maintainability, useful redacted observability, source and slice budgets, fixture leakage, and integration-owned generated-file discipline including exact-head transient codegen evidence. Use disposition pass, finding, or not_applicable with concrete evidence; not_applicable requires rationale and every finding requires a stable unique ID. Never edit the proof packet or any shared evidence. Never edit or commit product/worktree files. The only allowed write is .brain-review-output/quality.json in this factory-owned managed review worktree. Set reviewerRunId to the exact output of rtk proxy git branch --show-current. After writing it, run rtk proxy node --import tsx tooling/brain-factory/src/review-lens-guard.mts --lens quality; the trusted guard is mandatory, validates and commits only the branch-local artifact and delta, and writes nothing to shared evidence. Write the Task 1 ReviewLensArtifact schema with lens='quality', exact proof planSha256/taskBlockHash/baseSha/headSha, exact HEAD treeSha, reviewerRunId equal to the exact current isolated branch name, all rubricDispositions, all findings, and verdict derived from findings. planSha256 is retained provenance; any taskBlockHash drift is rework. Do not run tests or broad verify. Whenever Git output will be copied into or machine-parsed for the proof packet or lens artifact, use rtk proxy git; filtered rtk git output must never feed structured evidence."]


  review_aggregate [shape=parallelogram, goal_gate=true, retry_target=implement, timeout="300s", script="set -euo pipefail; cd \"$BRAIN_WORKDIR\"; rtk proxy node --import tsx tooling/brain-factory/src/review-aggregate.mts --task \"$BRAIN_TASK_ID\" --attempt \"$BRAIN_REVIEW_ATTEMPT\" --workdir \"$BRAIN_WORKDIR\" --review-repo \"$BRAIN_WORKDIR\" --evidence \"$BRAIN_EVIDENCE_DIR\""]

  aggregate_gate [shape=parallelogram, goal_gate=true, retry_target=implement, timeout="300s", script="set -euo pipefail; PROOF=\"$BRAIN_EVIDENCE_DIR/lane-results/$BRAIN_TASK_ID/ci-proof-packet.json\"; rtk proxy node -e \"const p=require(process.argv[1]); if(p.reviewVerdict!=='pass'||!Array.isArray(p.reviewFindings)||p.reviewFindings.length!==0) throw new Error('aggregate review requires rework')\" \"$PROOF\""]

  complete [shape=parallelogram, goal_gate=true, retry_target=complete, max_retries=1, timeout="300s", script="set -euo pipefail; cd \"$BRAIN_WORKDIR\"; rtk proxy node --import tsx tooling/brain-factory/src/write-lane-result.mts --task \"$BRAIN_TASK_ID\" --evidence \"$BRAIN_EVIDENCE_DIR\" --reproof-request \"$BRAIN_REPROOF_REQUEST\""]

  final_gates [shape=parallelogram, goal_gate=true, retry_target=implement, timeout="5400s", script="set -euo pipefail; export HOST_TEST_MAX_LOAD_1M=\"$BRAIN_HOST_TEST_MAX_LOAD_1M\"; cd \"$BRAIN_WORKDIR\"; rtk proxy node --import tsx tooling/brain-factory/src/review-cycle-marker.mts --task \"$BRAIN_TASK_ID\" --evidence \"$BRAIN_EVIDENCE_DIR\"; rtk proxy node --import tsx tooling/brain-factory/src/lane-gates.mts --task \"$BRAIN_TASK_ID\" --evidence \"$BRAIN_EVIDENCE_DIR\" --stage final --reuse-pre-review --reproof-request \"$BRAIN_REPROOF_REQUEST\""]

  start -> preflight
  preflight -> apply_archive [condition="outcome=succeeded"]
  preflight -> exit [label="blocked"]
  apply_archive -> implement [condition="outcome=succeeded"]
  apply_archive -> exit [label="invalid archive coordinates"]
  implement -> gates
  gates -> review_snapshot [condition="outcome=succeeded"]
  gates -> implement [label="red"]
  review_snapshot -> review_fork [condition="outcome=succeeded"]
  review_snapshot -> implement [label="dirty"]
  review_fork -> review_contract
  review_fork -> review_safety
  review_fork -> review_quality
  review_contract -> review_merge
  review_safety -> review_merge
  review_quality -> review_merge
  review_merge -> review_aggregate
  review_aggregate -> aggregate_gate
  aggregate_gate -> final_gates [condition="outcome=succeeded"]
  aggregate_gate -> implement [label="rework"]
  final_gates -> complete [condition="outcome=succeeded"]
  final_gates -> implement [label="red"]
  complete -> exit
}
