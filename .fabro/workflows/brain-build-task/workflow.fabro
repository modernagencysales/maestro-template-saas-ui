digraph BrainBuildTask {
  graph [
    goal="Implement one approved Maestro Brain task with test-first focused proof",
    inputs="workdir,evidence_dir,task_id,base_sha,start_sha,resume_mode,resume_source_head,resume_task_base,resume_commits,reproof_request",
    model_stylesheet="
      #implement { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
      #review    { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
    ",
    rankdir=LR
  ]
  start [shape=Mdiamond]
  exit [shape=Msquare]

  preflight [shape=parallelogram, goal_gate=true, retry_target=preflight, max_retries=1, timeout="600s", script="set -euo pipefail; WORKDIR='{{ inputs.workdir|default('__required_workdir__') }}'; TASK='{{ inputs.task_id|default('__required_task__') }}'; E='{{ inputs.evidence_dir|default('__required_evidence__') }}'; EXPECTED='{{ inputs.start_sha|default('__required_start__') }}'; rtk proxy test \"${WORKDIR#/}\" != \"$WORKDIR\"; rtk proxy test \"${E#/}\" != \"$E\"; cd \"$WORKDIR\"; rtk proxy test -n \"$EXPECTED\"; rtk proxy test -s docs/superpowers/execution/maestro-brain/task-manifest.json; rtk proxy test -s docs/superpowers/plans/2026-07-14-maestro-brain-agency-context-os-implementation-plan.md; rtk proxy mkdir -p \"$E/lane-results/$TASK\"; STATUS=$(rtk proxy git status --porcelain); rtk proxy test -z \"$STATUS\"; rtk proxy test \"$(rtk proxy git rev-parse HEAD)\" = \"$EXPECTED\""]

  apply_archive [shape=parallelogram, goal_gate=true, retry_target=apply_archive, max_retries=1, timeout="600s", script="set -euo pipefail; MODE='{{ inputs.resume_mode|default('none') }}'; if [ \"$MODE\" = none ]; then exit 0; fi; rtk proxy test \"$MODE\" = conflict-aware; cd '{{ inputs.workdir|default('.') }}'; EXPECTED='{{ inputs.start_sha|default('__required_start__') }}'; SOURCE='{{ inputs.resume_source_head|default('__required_source__') }}'; BASE='{{ inputs.resume_task_base|default('__required_base__') }}'; COMMITS='{{ inputs.resume_commits|default('__required_commits__') }}'; rtk proxy test \"$(rtk proxy git rev-parse HEAD)\" = \"$EXPECTED\"; rtk proxy git cat-file -e \"$SOURCE^{commit}\"; rtk proxy git cat-file -e \"$BASE^{commit}\"; rtk proxy git merge-base --is-ancestor \"$BASE\" \"$SOURCE\"; OLD_IFS=$IFS; IFS=','; set -- $COMMITS; IFS=$OLD_IFS; rtk proxy test \"$#\" -gt 0; for COMMIT in \"$@\"; do rtk proxy git cat-file -e \"$COMMIT^{commit}\"; done; if ! rtk proxy git cherry-pick \"$@\"; then rtk proxy git status --short; exit 0; fi"]

  implement [label="Implement Task", max_visits=10, timeout="10800s", prompt="Before contract reading or edits, run rtk proxy git status --short. If an archived resume cherry-pick is in progress, resolve it as the task owner, preserve the archived intent, change only files within declared task ownership, and run rtk proxy git cherry-pick --continue until the pinned sequence is complete; if resolution requires an out-of-scope file, stop and report a contract gap. For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifact. Implement only task {{ inputs.task_id|default('__required_task__') }} in {{ inputs.workdir|default('__required_workdir__') }}. Read the root AGENTS.md by its exact path, the Parallel Execution Amendment and Appendices O/P, this task's complete packet in docs/superpowers/plans/2026-07-14-maestro-brain-agency-context-os-implementation-plan.md, its entry in docs/superpowers/execution/maestro-brain/task-manifest.json, every named playbook/anchor required by its classification, and only directly relevant source or vendored examples. Contract reading is not reconnaissance and is never skipped. After those required reads, make at most one scoped inventory pass per declared file-lock root and one exact-symbol or named-reference lookup per required seam. Do not repeat equivalent searches, compare alternative architectures, or re-investigate decisions fixed by the packet. Begin the first focused test edit once the target file, closest repository pattern, and focused command are known; if any remains unknown after the bounded pass, report a contract or template gap instead of widening the search. Never glob node_modules or the whole worktree to find instruction files. Do not repeat global product research. Before every edit or mutating shell command, verify the target is under the exact task workdir; use rtk proxy test for shell guards, never rtk test. Never invoke rtk python; use the native write_file tool, or rtk proxy python3 only when a script is truly necessary. Never edit, reset, clean, remove, or otherwise mutate the control checkout or any sibling worktree. The only allowed evidence write is {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/{{ inputs.task_id|default('__required_task__') }}/ci-proof-packet.json. Report accidental cross-worktree changes instead of cleaning them. Respect codeStartAfter as code-start authority and the original packet dependency as acceptance authority. If the branch already contains this task's implementation, review and repair it instead of duplicating it. Compare the complete task diff from {{ inputs.base_sha|default('__required_base__') }}; when one task commit exceeds 300 changed hand-authored source lines, rewrite only the task's unintegrated history into coherent intention commits up to sourceSliceLimit from the task manifest, defaulting to four; honor an explicit expanded task limit when the manifest declares one. Every commit remains within the slice budget. Before every proof handoff, count the complete {{ inputs.base_sha|default('__required_base__') }}..HEAD task history; after any repair, if it exceeds the manifest sourceSliceLimit, mechanically rewrite only that unintegrated history into one to that limit before leaving implementation. A history rewrite must distribute real content across every intention commit: never create empty padding commits or use --allow-empty, and verify each commit with the factory's exact gate-counted source-line calculation before proof. Edit only declared files or stop and amend the task contract. Never edit generated files unless this task owns @generated-confect. Use fake/local providers by default. Write the new behavior's focused tests before its implementation and preserve typed errors, tenant isolation, lifecycle fencing, redaction, and the repository layer law. Use repo generators exactly when the packet is pattern-instance. Do not weaken gates, add unexplained suppressions, or implement another task. During implementation run only the smallest new or failing test needed to iterate. Do not invoke brain:factory:lane-gates yourself; the next deterministic workflow node owns the complete focused gate. Record every exact focused packet command for that node except broad just verify/verify-full, plus the relevant package-local lint/type/test commands. On a repair or archived resume, preserve focusedCommands exactly as declared by the existing proof and task contract; record newly run lint, typecheck, coverage, or diagnostic commands only as supplemental command results, never by adding them to focusedCommands. Broad verification belongs to tranche integration. Record focusedCommands as exact single-process commands beginning with rtk; do not record prose, output, shell chaining, quoting, or broad root test/typecheck/verify commands. Commit one to the manifest sourceSliceLimit coherent intentions with conventional subjects. Write the proof with schemaVersion='maestro-brain-ci-proof/v1', current planSha256/taskBlockHash, taskId, baseSha='{{ inputs.base_sha|default('__required_base__') }}', headSha, changedFiles, focusedCommands, testsAdded, reviewVerdict='pending', and knownRisks. Never invent or preserve stale plan/task hashes: a changed contract requires a new proof and gates. The proof head may precede only a byte-identical Fabro checkpoint and the worktree must be clean. Do not use native apply_patch in this Fabro lane; use only guarded targeted shell or write_file edits and inspect git diff immediately after every edit. Whenever Git output will be copied into or machine-parsed for the proof packet, including headSha, changedFiles, commit counts, or hashes, use rtk proxy git; filtered rtk git output is display-only and must never feed structured evidence."]

  gates [shape=parallelogram, goal_gate=true, retry_target=implement, timeout="5400s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; rtk proxy node --import tsx tooling/brain-factory/src/lane-gates.mts --task '{{ inputs.task_id|default('S01-T01') }}' --evidence '{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}' --stage pre-review --reproof-request '{{ inputs.reproof_request|default('none') }}'"]

  review_snapshot [shape=parallelogram, goal_gate=true, retry_target=implement, timeout="300s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; rtk proxy node --import tsx tooling/brain-factory/src/review-worktree-guard.mts capture --workdir '{{ inputs.workdir|default('.') }}' --task '{{ inputs.task_id|default('S01-T01') }}' --evidence '{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}'"]

  review [label="Independent Read-Only Contract Review", max_visits=10, timeout="5400s", prompt="For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifact. Independently review task {{ inputs.task_id|default('__required_task__') }} in {{ inputs.workdir|default('__required_workdir__') }} against its full task packet, design requirements, task-manifest ownership, AGENTS.md, tests, and {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/{{ inputs.task_id|default('__required_task__') }}/ci-proof-packet.json. Never edit, amend, or commit product/worktree files and never certify a repair authored in this review turn. The only allowed write is that exact proof packet. Do not use native apply_patch in this review node; update the exact proof packet with one guarded targeted shell write and inspect it immediately. Verify schemaVersion maestro-brain-ci-proof/v1, retained planSha256 provenance, and the exact current taskBlockHash before reviewing; never repair stale contract identity during review. planSha256 is retained provenance: an unrelated global plan change is not contract drift when this task's taskBlockHash is unchanged; any taskBlockHash drift is rework. Inspect the actual committed diff. Treat an exact passed pre-review lane-gate report for the same head and task contract as authoritative command-execution evidence. Rerun a focused command only when that report or its evidence is inconsistent; semantic inspection of the tests and diff remains mandatory. Look specifically for false-green tests, missing expected errors, cross-tenant access, stale-generation races, lifecycle resurrection, secret/customer-text exposure, layer skips, fixture leakage, generated-file drift, and scope beyond the task. On any defect or contract drift set reviewVerdict='rework' and add stable-ID reviewFindings; the final gate will route the task back to the implementation owner. Only when no defect remains set reviewVerdict='pass', bind it to exact HEAD, preserve the exact contract hashes, and leave reviewFindings empty. Do not run broad verify. Whenever Git output will be copied into or machine-parsed for the proof packet, including headSha, changedFiles, commit counts, or hashes, use rtk proxy git; filtered rtk git output is display-only and must never feed structured evidence."]

  review_immutability [shape=parallelogram, goal_gate=true, retry_target=implement, timeout="300s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; rtk proxy node --import tsx tooling/brain-factory/src/review-worktree-guard.mts verify --workdir '{{ inputs.workdir|default('.') }}' --task '{{ inputs.task_id|default('S01-T01') }}' --evidence '{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}'"]

  review_gate [shape=parallelogram, goal_gate=true, retry_target=review, timeout="300s", script="set -euo pipefail; PROOF='{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}/lane-results/{{ inputs.task_id|default('S01-T01') }}/ci-proof-packet.json'; rtk proxy node -e \"const p=require(process.argv[1]); if(!['pass','rework'].includes(p.reviewVerdict)) throw new Error('independent review left a non-terminal verdict')\" \"$PROOF\""]

  complete [shape=parallelogram, goal_gate=true, retry_target=complete, max_retries=1, timeout="300s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; rtk proxy node --import tsx tooling/brain-factory/src/write-lane-result.mts --task '{{ inputs.task_id|default('S01-T01') }}' --evidence '{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}' --reproof-request '{{ inputs.reproof_request|default('none') }}'"]

  final_gates [shape=parallelogram, goal_gate=true, retry_target=implement, timeout="5400s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; rtk proxy node --import tsx tooling/brain-factory/src/review-cycle-marker.mts --task '{{ inputs.task_id|default('S01-T01') }}' --evidence '{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}'; rtk proxy node --import tsx tooling/brain-factory/src/lane-gates.mts --task '{{ inputs.task_id|default('S01-T01') }}' --evidence '{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}' --stage final --reuse-pre-review --reproof-request '{{ inputs.reproof_request|default('none') }}'"]

  start -> preflight
  preflight -> apply_archive [condition="outcome=succeeded"]
  preflight -> exit [label="blocked"]
  apply_archive -> implement [condition="outcome=succeeded"]
  apply_archive -> exit [label="invalid archive coordinates"]
  implement -> gates
  gates -> review_snapshot [condition="outcome=succeeded"]
  gates -> implement [label="red"]
  review_snapshot -> review [condition="outcome=succeeded"]
  review_snapshot -> implement [label="dirty"]
  review -> review_immutability
  review_immutability -> review_gate [condition="outcome=succeeded"]
  review_immutability -> implement [label="mutated"]
  review_gate -> complete [condition="outcome=succeeded"]
  review_gate -> review_snapshot [label="pending"]
  complete -> final_gates
  final_gates -> exit [condition="outcome=succeeded"]
  final_gates -> implement [label="red"]
}
