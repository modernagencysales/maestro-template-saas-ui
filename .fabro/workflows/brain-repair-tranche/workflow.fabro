digraph BrainRepairTranche {
  graph [
    goal="Repair a reviewed Maestro Brain tranche without repeating integration",
    inputs="workdir,evidence_dir,tranche,base_sha,source_review_run,control_root",
    model_stylesheet="
      #repair { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
      #review { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
    ",
    rankdir=LR
  ]
  start [shape=Mdiamond]
  exit [shape=Msquare]

  preflight [shape=parallelogram, goal_gate=true, retry_target=preflight, max_retries=1, timeout="600s", script="set -euo pipefail; WORKDIR='{{ inputs.workdir|default('__required_workdir__') }}'; EVIDENCE='{{ inputs.evidence_dir|default('__required_evidence__') }}'; CONTROL='{{ inputs.control_root|default('__required_control__') }}'; BASE='{{ inputs.base_sha|default('__required_base__') }}'; SOURCE_RUN='{{ inputs.source_review_run|default('__required_source_run__') }}'; TRANCHE='{{ inputs.tranche|default('__required_tranche__') }}'; rtk proxy test -n \"$WORKDIR\"; rtk proxy test -n \"$EVIDENCE\"; rtk proxy test -n \"$CONTROL\"; rtk proxy test -n \"$BASE\"; rtk proxy test -n \"$SOURCE_RUN\"; rtk proxy test -n \"$TRANCHE\"; rtk proxy test \"${WORKDIR#/}\" != \"$WORKDIR\"; rtk proxy test \"${EVIDENCE#/}\" != \"$EVIDENCE\"; rtk proxy test \"$(rtk proxy realpath \"$WORKDIR\")\" != \"$(rtk proxy realpath \"$CONTROL\")\"; rtk proxy test \"${WORKDIR#*/.maestro-brain-fabro-workdirs/}\" != \"$WORKDIR\"; cd \"$WORKDIR\"; rtk proxy test \"$(rtk git rev-parse HEAD)\" = \"$BASE\"; rtk proxy test -s \"$EVIDENCE/integration/$TRANCHE/integration-result.json\"; rtk proxy jq -e --arg run \"$SOURCE_RUN\" '.reviewVerdict == \"rework\" and (.sourceReviewRun // $run) == $run' \"$EVIDENCE/integration/$TRANCHE/integration-result.json\""]

  repair [label="Repair Reviewed Tranche", max_visits=3, timeout="10800s", prompt="Continue the already-integrated tranche {{ inputs.tranche|default('__required_tranche__') }} in the exact workdir {{ inputs.workdir|default('__required_workdir__') }}. Do not cherry-pick task lanes again and do not reset or discard the inherited repair diff. Read root AGENTS.md, the source review run {{ inputs.source_review_run|default('__required_source_run__') }}, integration-result.json, the complete committed/uncommitted diff, and included task proofs. Before every mutation verify the target is inside the exact integration workdir; only this tranche's evidence JSON may be written outside it. Resolve every recorded critical/high finding with honest negative tests first and use requiredFindingIds as the exact resolution contract. Do not invent findings from another tranche. Where recorded findings concern content-bearing LLM request integrity/admission, server-derived API-key authority, explicit fake-only tenancy, external-artifact evals, export lifecycle fencing, or tenant/lifecycle-complete receipts, preserve those boundaries exactly. A legacy integration failure requires an independent review and a genuinely passing full gate; never relabel the old failure as passed. Split repairs into coherent commits of at most 300 hand-authored source lines and preserve provider/server/client boundaries. Run every test through rtk host-test-slot --class focused and run focused lint/typechecks; never run broad verify. Update evidence with sourceReviewRun, exact head, remainingFindings, and resolvedFindings using the stable IDs required by the deterministic checker. If any critical/high item remains, keep reviewVerdict rework. If native apply_patch fails once, switch to a targeted edit and inspect git diff immediately."]

  review [label="Independent Repair Review", max_visits=3, timeout="7200s", prompt="Perform a read-only independent review of repaired tranche {{ inputs.tranche|default('__required_tranche__') }} in {{ inputs.workdir|default('__required_workdir__') }} against task packets, proofs, AGENTS.md, integration-result.json, and the complete diff from {{ inputs.base_sha|default('__required_base__') }}. Do not edit or commit product/worktree files. Check tenant authority, lifecycle deletion/revocation, exact LLM artifact integrity and admitted provider payload, public/internal separation, provider bundling, generated refs, typed errors, slice budgets, and real run-artifact evals. You may update only this tranche's evidence JSON: on any defect set reviewVerdict rework and append a stable-ID remainingFinding, then return to repair; otherwise set status ready_for_review, reviewVerdict pass, exact headSha, remainingFindings empty, and focused read-only checks. Never certify changes authored in this review turn. Do not run broad verify."]

  review_gate [shape=parallelogram, goal_gate=true, retry_target=repair, timeout="600s", script="set -euo pipefail; rtk pnpm --dir '{{ inputs.control_root|default('__required_control__') }}/tooling/brain-factory' exec tsx src/repair-result-check.mts --workdir '{{ inputs.workdir|default('__required_workdir__') }}' --evidence '{{ inputs.evidence_dir|default('__required_evidence__') }}' --tranche '{{ inputs.tranche|default('__required_tranche__') }}' --base '{{ inputs.base_sha|default('__required_base__') }}' --stage review"]

  gates [shape=parallelogram, goal_gate=true, retry_target=repair, timeout="10800s", script="set -euo pipefail; cd '{{ inputs.workdir|default('__required_workdir__') }}'; rtk host-test-slot --class full pnpm verify; rtk git diff --check '{{ inputs.base_sha|default('__required_base__') }}..HEAD'; STATUS=$(rtk proxy git status --porcelain); rtk proxy test -z \"$STATUS\""]

  record [label="Record Repaired Integration", max_visits=2, timeout="1800s", prompt="The deterministic full gate passed for repaired tranche {{ inputs.tranche|default('__required_tranche__') }}. Mutate only the exact integration workdir and named tranche/task JSON evidence. Preserve failure/repair history. Update integration-result.json with exact HEAD, status passed, reviewVerdict pass, and broadGate { status: passed, headSha: HEAD, command: rtk host-test-slot --class full pnpm verify }. Update every included lane-result to integrated with integrationHeadSha and tranche without changing proof/head fields. Never mark accepted unless its original acceptanceAfter condition is actually present. Leave the worktree clean."]
  post_record [shape=parallelogram, goal_gate=true, retry_target=record, max_retries=1, timeout="600s", script="set -euo pipefail; rtk pnpm --dir '{{ inputs.control_root|default('__required_control__') }}/tooling/brain-factory' exec tsx src/repair-result-check.mts --workdir '{{ inputs.workdir|default('__required_workdir__') }}' --evidence '{{ inputs.evidence_dir|default('__required_evidence__') }}' --tranche '{{ inputs.tranche|default('__required_tranche__') }}' --base '{{ inputs.base_sha|default('__required_base__') }}' --stage record"]

  start -> preflight
  preflight -> repair [condition="outcome=succeeded"]
  preflight -> exit [label="blocked"]
  repair -> review -> review_gate
  review_gate -> gates [condition="outcome=succeeded"]
  review_gate -> repair [label="rework"]
  gates -> record [condition="outcome=succeeded"]
  gates -> repair [label="red"]
  record -> post_record
  post_record -> exit [condition="outcome=succeeded"]
  post_record -> record [label="record invalid"]
}
