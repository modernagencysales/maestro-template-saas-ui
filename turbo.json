{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"],
      "env": [
        "APP_PROVIDER_MODE",
        "TEMPLATE_RUNTIME_MODE",
        "VITE_CONVEX_URL",
        "VITE_MAESTRO_AUTH_MODE"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check:convex": {
      "cache": false
    }
  }
}
