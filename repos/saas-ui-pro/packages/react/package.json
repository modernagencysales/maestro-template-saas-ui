{
  "name": "@saas-ui-pro/react",
  "version": "1.0.0-next.5",
  "license": "https://saas-ui.dev/license",
  "type": "module",
  "exports": {
    ".": {
      "sui-pro": "./src/index.ts",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "sui-pro": "./src/components/*/index.ts",
      "require": "./dist/components/*/index.cjs",
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./hooks": {
      "sui-pro": "./src/hooks/index.ts",
      "require": "./dist/hooks/index.cjs",
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./utils": {
      "sui-pro": "./src/utils/index.ts",
      "require": "./dist/utils/index.cjs",
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./preset": {
      "sui-pro": "./src/theme/index.ts",
      "require": "./dist/theme/index.cjs",
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=16384' tsup --config tsup.config.ts",
    "lint": "TIMING=1 eslint src/**/*.ts* --fix",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/saas-js/saas-ui-pro.git",
    "directory": "saas-ui/pro"
  },
  "dependencies": {
    "@ark-ui/react": "5.27.1",
    "@react-hookz/web": "^25.2.0",
    "@saas-ui-pro/onboarding": "workspace:*",
    "@saas-ui/chakra-preset": "3.0.0-next.9",
    "@saas-ui/hooks": "3.0.0-next.4",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/react-virtual": "^3.13.4",
    "@types/lodash": "^4.17.21",
    "@zag-js/dom-utils": "^0.2.4",
    "@zag-js/react": "^1.29.1",
    "date-fns": "^4.1.0"
  },
  "peerDependencies": {
    "@chakra-ui/react": "3.28.1",
    "@emotion/react": ">=11",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@chakra-ui/react": "3.28.1",
    "@emotion/react": "^11.14.0",
    "@ngneat/falso": "^7.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser-playwright": "^4.0.14",
    "@zag-js/core": "^1.29.1",
    "@zag-js/types": "^1.29.1",
    "lodash": "^4.17.21",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.5.0",
    "tsup": "^8.5.1",
    "vitest": "^4.0.14"
  }
}
