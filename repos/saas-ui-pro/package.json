{
  "name": "saas-ui-pro",
  "description": "Saas UI Pro utilities, components and blocks",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saas-js/saas-ui-pro.git"
  },
  "author": "Eelco Wiersma <eelco@saas-ui.dev>",
  "license": "https://saas-ui.dev/license",
  "scripts": {
    "prepare": "husky install",
    "registry:sync-public": "tsx packages/registry/scripts/sync-public.ts",
    "registry:repair-public": "tsx packages/registry/scripts/repair-public-catalog.ts",
    "registry:prepare-public": "tsx packages/registry/scripts/prepare-public.ts",
    "registry:build": "pnpm registry:prepare-public && pnpm --filter @saas-ui-pro/registry build",
    "registry:check": "pnpm --filter @saas-ui-pro/registry check",
    "registry:ci": "pnpm registry:prepare-public && pnpm --filter @saas-ui-pro/registry test:ci",
    "registry:storybook:check": "pnpm --filter @saas-ui-pro/registry check:previews",
    "dev:demo": "pnpm --filter demo dev",
    "build": "turbo run build --filter='@saas-ui-pro/*' --filter=demo",
    "build:demo": "pnpm --filter demo build",
    "build:tokens": "chakra typegen apps/demo/src/theme/theme.ts",
    "build:system": "chakra typegen packages/react/src/preset.ts",
    "clean:packages": "turbo run clean",
    "eslint": "eslint --cache --cache-location=node_modules/.cache/.eslintcache --fix",
    "format:check": "prettier --check apps/** --check packages/**",
    "format:write": "prettier --write apps/** --check packages/**",
    "lint": "pnpm run eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:staged": "lint-staged --allow-empty --config lint-staged.config.cjs",
    "typecheck": "tsc --noEmit",
    "build:packages": "turbo run build --filter='@saas-ui-pro/*' --concurrency=5 --continue",
    "storybook": "pnpm --filter saas-ui-storybook-pro dev",
    "publish": "pnpm --filter '@saas-ui-pro/*' publish --access public",
    "publish:next": "pnpm --filter '@saas-ui-pro/*' publish --tag next --access public --publish-branch v3 --no-git-checks",
    "release": "pnpm run changeset:version && pnpm run build:packages && pnpm run publish:next",
    "test": "vitest"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.30.0",
    "@chakra-ui/react": "3.30.0",
    "@changesets/cli": "^2.29.7",
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^9.39.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^4.2.2",
    "eslint-plugin-cypress": "^4.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "next": "^16.2.0",
    "prettier": "^3.5.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "turbo": "^2.6.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "eslint-plugin-storybook": "10.0.5",
    "typescript-eslint": "^8.48.0",
    "tsx": "^4.20.6"
  },
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67"
}
