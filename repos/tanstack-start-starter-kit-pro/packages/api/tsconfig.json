{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "#trpc": ["./trpc/trpc.ts"],
      "#adapters": ["./adapters/index.ts"],
      "#adapters/*": ["./adapters/*"],
      "#modules/*": ["./modules/*"],
      "#utils/*": ["./utils/*"],
      "#types": ["./types.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["**/node_modules"]
}
