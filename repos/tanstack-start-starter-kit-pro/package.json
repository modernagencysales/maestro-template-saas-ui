{
  "name": "saas-js-tanstack-start",
  "version": "0.1.0",
  "description": "Saas.js - Tanstack Start starter kit",
  "repository": "git@github.com:saas-js/tanstack-start-starter-kit-pro.git",
  "author": "Eelco Wiersma <eelco@saas-ui.dev>",
  "license": "https://saas-js.com/license",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "init:env": "turbo gen env",
    "dev": "pnpm run dev:web",
    "dev:web": "pnpm --filter=web dev",
    "dev:db": "docker compose up -d",
    "dev:email": "pnpm --filter=email dev",
    "storybook": "turbo run storybook",
    "build:web": "turbo build --filter=web",
    "build:storybook": "turbo run storybook:build",
    "generate:tokens": "chakra typegen apps/web/src/theme/preset.ts",
    "db:push": "turbo run db:push",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "pnpm --filter @workspace/db db:studio",
    "db:seed": "pnpm --filter @workspace/db db:seed",
    "billing:sync": "turbo run billing:sync",
    "clean:changelogs": "tsx scripts/clean-changelogs.ts",
    "workspace:namespace": "tsx scripts/workspace.ts --namespace",
    "typecheck": "turbo run typecheck",
    "test:smoke": "pnpm exec playwright test tests/auth.spec.ts --project=chromium",
    "check:fast": "pnpm lint && pnpm typecheck",
    "check:full": "pnpm lint && pnpm typecheck && pnpm test:smoke",
    "clean": "turbo run clean",
    "format:check": "prettier --check apps/** --check packages/**",
    "format:write": "prettier --write apps/** --check packages/**",
    "lint": "eslint .",
    "lint:web": "eslint apps/web",
    "lint:fix": "eslint . --cache --cache-location=node_modules/.cache/.eslintcache --fix",
    "lint:staged": "lint-staged --allow-empty --config lint-staged.config.js",
    "upgrade:pkg": "pnpm up --latest --recursive --interactive"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "devDependencies": {
    "@chakra-ui/cli": "^3.36.0",
    "@chakra-ui/react": "3.33.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "^6.16.12",
    "@ngneat/falso": "^8.0.2",
    "@playwright/test": "^1.61.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@turbo/gen": "^2.10.4",
    "@types/node": "^22.20.1",
    "@workspace/better-auth": "workspace:*",
    "@workspace/config": "workspace:*",
    "@workspace/db": "workspace:*",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pkg-types": "^2.3.1",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.0",
    "turbo": "^2.10.4",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10",
    "yargs": "^18.0.0"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "engines": {
    "node": ">=22"
  }
}
