{
  "name": "maestro-template",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "maestro": "tsx apps/cli/src/index.ts",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck --concurrency=1",
    "check:effect-diagnostics": "effect-language-service diagnostics --project packages/convex/tsconfig.json --format github-actions --strict",
    "test": "pnpm test:bootstrap && turbo run test --filter=!@maestro-template/release-tooling --filter=!@maestro-template/agent-pack --filter=!@maestro-template/cli --filter=!@maestro-template/convex-compat && pnpm --dir tooling/agent-pack test && pnpm --dir apps/cli test && pnpm --dir tooling/convex-compat test && pnpm --dir packages/convex test:workflow-conformance && pnpm --dir apps/cli test:customer-cli-runtime && pnpm --dir apps/cli test:create-root-integration && pnpm --dir tooling/agent-pack test:privacy-no-network && pnpm --dir tooling/release test:unit && pnpm test:release-filesystem",
    "test:release-filesystem": "pnpm --dir tooling/release test:final-filesystem",
    "test:runtime-longevity": "pnpm --dir apps/web test:runtime-longevity",
    "test:chassis-ci": "vitest run tooling/ci/verify-chassis.test.mts --maxWorkers=1 --no-file-parallelism",
    "test:bootstrap": "node --test scripts/maestro-bootstrap.test.mjs",
    "test:tooling": "pnpm test:bootstrap && pnpm --dir tooling/quality test && pnpm --dir tooling/workflow test && pnpm --dir tooling/generators test && pnpm --dir tooling/evals test && pnpm --dir tooling/release test:unit",
    "test:app-map": "pnpm --dir tooling/app-map test",
    "test:workflow": "pnpm --dir tooling/workflow test",
    "test:convex-compat": "pnpm --dir tooling/convex-compat test",
    "test:pr-backlog": "pnpm --dir tooling/pr-backlog test",
    "test:stack": "pnpm --dir tooling/stack test",
    "stack:check": "tsx tooling/stack/check.mts",
    "stack:status": "tsx tooling/stack/status.mts",
    "stack:submit": "tsx tooling/stack/submit.mts",
    "stack:sync": "tsx tooling/stack/sync.mts",
    "stack:preflight": "tsx tooling/stack/merge-preflight.mts",
    "stack:merge": "tsx tooling/stack/merge.mts",
    "evals": "pnpm --dir tooling/evals test",
    "evals:agent-pack": "tsx tooling/agent-pack/evals/walking-skeleton/cli.ts",
    "build": "turbo run build",
    "confect:codegen": "pnpm --dir packages/convex confect:codegen",
    "confect:manifest": "tsx tooling/confect-manifest/src/generate.ts",
    "email:setup": "tsx scripts/configure-postmark.mts",
    "confect:dev": "pnpm --dir packages/convex confect:dev",
    "convex:dev": "convex dev",
    "dev:backend": "pnpm --dir packages/convex dev:backend",
    "template:init": "tsx tooling/generators/src/cli.ts init",
    "template:doctor": "tsx tooling/generators/src/cli.ts doctor",
    "template:quickstart": "tsx tooling/generators/src/cli.ts quickstart",
    "template:intake": "tsx tooling/generators/src/cli.ts intake",
    "template:seed-demo": "tsx tooling/generators/src/cli.ts seed-demo",
    "template:handoff": "tsx tooling/generators/src/cli.ts handoff",
    "template:systems": "tsx tooling/generators/src/cli.ts systems",
    "template:prototype": "tsx tooling/generators/src/cli.ts prototype",
    "template:add-client-domain": "tsx tooling/generators/src/cli.ts add-client-domain",
    "template:add-feature": "tsx tooling/generators/src/cli.ts add-feature",
    "template:add-capability": "tsx tooling/generators/src/cli.ts add-capability",
    "template:add-table": "tsx tooling/generators/src/cli.ts add-table",
    "template:add-workflow": "tsx tooling/generators/src/cli.ts add-workflow",
    "template:bump-workflow": "tsx tooling/generators/src/cli.ts bump-workflow",
    "template:bump-capability": "tsx tooling/generators/src/cli.ts bump-capability",
    "template:publish-workflow": "tsx tooling/generators/src/cli.ts publish-workflow",
    "template:publish-capability": "tsx tooling/generators/src/cli.ts publish-capability",
    "template:regenerate-workflow-publications": "tsx tooling/generators/src/workflow-publication-generation.ts",
    "template:add-agent": "tsx tooling/generators/src/cli.ts add-agent",
    "template:add-agent-seat": "tsx tooling/generators/src/cli.ts add-agent-seat",
    "template:promote-capability": "tsx tooling/generators/src/cli.ts promote-capability",
    "template:promote-workflow": "tsx tooling/generators/src/cli.ts promote-workflow",
    "template:workflow-output-smoke": "tsx tooling/generators/src/workflow-output-smoke.ts",
    "template:upgrade": "tsx tooling/generators/src/cli.ts upgrade",
    "release:seal": "tsx tooling/release-seal.mts",
    "template:private-package:dry-run": "tsx tooling/generators/src/cli.ts private-package:dry-run",
    "template:private-package:import": "tsx tooling/generators/src/cli.ts private-package:import",
    "pattern-fit": "tsx scripts/pattern-fit.mts",
    "check:convex": "pnpm --dir packages/convex check:convex",
    "check:confect-compat": "tsx tooling/quality/check-confect-compat.mts",
    "check:convex-compat": "pnpm test:convex-compat",
    "check:ci-completeness": "tsx tooling/quality/check-ci-completeness.mts",
    "check:config-drift": "tsx tooling/quality/check-config-drift.mts",
    "check:deps": "tsx tooling/quality/check-deps.mts",
    "check:knip": "knip --config knip.json",
    "check:route-tree": "tsx tooling/quality/check-route-tree.mts",
    "check:frontend-effect-boundary": "tsx tooling/quality/check-frontend-effect-boundary.mts",
    "check:env-boundary": "tsx tooling/quality/check-env-boundary.mts",
    "check:provider-boundary": "tsx tooling/quality/check-provider-boundary.mts",
    "check:logging-boundary": "tsx tooling/quality/check-logging-boundary.mts",
    "check:access-audit-events": "tsx tooling/quality/check-access-audit-events.mts",
    "check:coverage-ratchet": "vitest run --coverage --maxWorkers=1 --no-file-parallelism --exclude apps/cli/src/factory/customerCliRuntime.test.ts --exclude apps/cli/src/factory/createRootIntegration.test.ts --exclude tooling/release/src/customerTarget/finalFilesystem.test.ts packages/template-core packages/integrations packages/search packages/storage packages/notifications packages/observability packages/convex tooling/quality tooling/workflow tooling/release tooling/generators tooling/stack apps/cli apps/web && tsx tooling/quality/check-coverage-ratchet.mts",
    "check:types-coverage": "node --max-old-space-size=8192 node_modules/type-coverage/bin/type-coverage --project tsconfig.type-coverage.json --at-least 99.7",
    "check:gates": "tsx tooling/quality/check-gates.mts",
    "check:debt": "tsx tooling/quality/check-debt.mts",
    "check:generators": "tsx tooling/quality/check-generators.mts",
    "check:recipes": "tsx tooling/quality/check-recipes.mts",
    "check:docs-freshness": "tsx tooling/quality/check-docs-freshness.mts",
    "check:generated-files": "tsx tooling/quality/check-generated-files.mts",
    "check:confect-effect-compat": "tsx tooling/quality/check-confect-effect-compat.mts",
    "check:confect-contracts": "tsx tooling/quality/check-confect-contracts.mts",
    "check:workflow-graph-boundary": "tsx tooling/quality/check-workflow-graph-boundary.mts",
    "check:workflow-policy-snapshots": "tsx tooling/quality/check-workflow-policy-snapshots.mts",
    "check:workflow-principal-propagation": "tsx tooling/quality/check-workflow-principal-propagation.mts",
    "check:workflow-semantics": "tsx tooling/quality/check-workflow-semantics.mts",
    "check:workflow-version-immutability": "tsx tooling/quality/check-workflow-version-immutability.mts",
    "check:workflow-publication-generation": "tsx tooling/generators/src/workflow-publication-generation.ts",
    "check:workflow:fast": "pnpm --dir tooling/eslint-plugin-template test && pnpm --dir packages/template-core test workflow-semantics && pnpm check:workflow-semantics",
    "check:schema-migration-notes": "tsx tooling/quality/check-schema-migration-notes.mts",
    "data-resources:generate": "tsx tooling/quality/check-data-resources.mts --write",
    "check:data-resources": "tsx tooling/quality/check-data-resources.mts",
    "check:append-only-tables": "tsx tooling/quality/check-append-only-tables.mts",
    "check:system-catalog": "tsx tooling/quality/check-system-catalog.mts",
    "check:system-topology": "tsx tooling/quality/check-system-topology.mts",
    "check:promotion-boundary": "tsx tooling/quality/check-promotion-boundary.mts",
    "check:layer-boundaries": "depcruise --config dependency-cruiser.config.cjs apps packages tooling tests experiments",
    "check:secret-canaries": "gitleaks detect --config .gitleaks.toml --no-git --redact --source .",
    "check:sbom-license": "tsx tooling/quality/check-sbom-license.mts",
    "check:headless-surface-contract": "tsx tooling/quality/check-headless-surface-contract.mts",
    "check:posthog-readiness": "tsx tooling/quality/check-posthog-readiness.mts",
    "check:confect-manifest": "tsx tooling/confect-manifest/src/check.ts",
    "check:effectified-api-proof": "pnpm --dir tooling/effectified-api-proof typecheck",
    "check:auth-demo-bypass": "tsx tooling/quality/check-auth-demo-bypass.mts",
    "check:pr-health": "tsx tooling/quality/check-pr-health.mts",
    "check:unresolved-review-threads": "tsx tooling/quality/check-unresolved-review-threads.mts",
    "check:merge-conflicts": "tsx tooling/quality/check-merge-conflicts.mts",
    "check:qlty": "tsx tooling/quality/check-qlty.mts",
    "acceptance:syntax": "tsx tooling/acceptance/source-check.mts",
    "acceptance:check": "pnpm acceptance:syntax && cucumber-js --config cucumber.cjs --dry-run --tags @required",
    "acceptance:cucumber": "cucumber-js --config cucumber.cjs",
    "contract-review": "tsx tooling/quality/contract-review.mts",
    "review:contract": "pnpm contract-review",
    "taste": "tsx tooling/quality/taste.mts",
    "taste:eval": "tsx tooling/quality/taste-eval.mts",
    "smoke:web-static": "tsx tooling/release/src/index.ts smoke-web-static",
    "review:readiness": "tsx tooling/release/src/index.ts review-readiness",
    "review:completion": "tsx tooling/release/src/index.ts review-completion",
    "smoke:hosted": "curl -fsSI ${TEMPLATE_HOSTED_URL:-https://maestro-template.pages.dev}",
    "smoke:hosted:browser": "playwright test tests/e2e/hosted-reference-app.spec.ts",
    "smoke:hosted:a11y": "playwright test tests/e2e/hosted-reference-app.accessibility.spec.ts",
    "smoke:hosted:visual": "playwright test tests/e2e/hosted-reference-app.visual.spec.ts",
    "deploy:doctor": "tsx tooling/release/src/index.ts deploy-doctor",
    "check:deploy-authority": "tsx tooling/quality/check-deploy-authority.mts",
    "deploy:cloudflare": "VITE_CONVEX_URL=\"$(node scripts/_project-config.mjs get production convexUrl)\" pnpm build && pnpm smoke:web-static && tsx tooling/release/src/deploy/guardedDeploy.ts cloudflare",
    "test:mutation": "bash tooling/ci/mutation.sh",
    "verify": "pnpm check:format && pnpm lint && pnpm typecheck && pnpm check:effect-diagnostics && pnpm test && pnpm build && pnpm check:ci-completeness && pnpm check:config-drift && pnpm check:convex-ai-files && pnpm check:agent-pack && pnpm check:deps && pnpm check:knip && pnpm check:route-tree && pnpm check:frontend-effect-boundary && pnpm check:env-boundary && pnpm check:provider-boundary && pnpm check:logging-boundary && pnpm check:access-audit-events && pnpm check:coverage-ratchet && pnpm check:types-coverage && pnpm check:gates && pnpm check:debt && pnpm check:generators && pnpm check:docs-freshness && pnpm check:generated-files && pnpm check:confect-effect-compat && pnpm check:confect-contracts && pnpm check:confect-compat && pnpm check:effectified-api-proof && pnpm check:workflow-semantics && pnpm check:workflow-graph-boundary && pnpm check:schema-migration-notes && pnpm check:system-catalog && pnpm check:system-topology && pnpm check:data-resources && pnpm check:append-only-tables && pnpm check:promotion-boundary && pnpm check:layer-boundaries && pnpm check:secret-canaries && pnpm check:sbom-license && pnpm check:confect-manifest && pnpm check:headless-surface-contract && pnpm check:posthog-readiness && pnpm check:auth-demo-bypass",
    "coverage:update-baseline": "vitest run --coverage packages/template-core packages/integrations packages/search packages/storage packages/notifications packages/observability packages/convex tooling/quality tooling/workflow tooling/release tooling/generators tooling/stack apps/cli apps/web && tsx tooling/quality/check-coverage-ratchet.mts --update",
    "prepare": "lefthook install",
    "convex:codegen": "convex codegen",
    "convex:deploy": "tsx tooling/release/src/deploy/guardedDeploy.ts convex",
    "convex:ai-files:install": "convex ai-files install",
    "convex:ai-files:status": "convex ai-files status",
    "check:convex-ai-files": "tsx tooling/quality/check-convex-ai-files.mts",
    "check:agent-pack": "tsx tooling/agent-pack/src/syncSkills.ts && tsx tooling/quality/check-agent-pack.mts",
    "check:app-map": "pnpm --dir tooling/app-map check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cucumber/cucumber": "13.2.0",
    "@effect/language-service": "0.87.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.45.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "3.2.6",
    "convex": "1.42.1",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^4.1.1",
    "knip": "^6.23.0",
    "lefthook": "1.10.5",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
