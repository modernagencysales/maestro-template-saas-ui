{
  "name": "maestro-template",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "check:effect-diagnostics": "effect-language-service diagnostics --project packages/convex/tsconfig.json --format github-actions --strict",
    "test": "turbo run test",
    "test:tooling": "pnpm --dir tooling/quality test && pnpm --dir tooling/workflow test && pnpm --dir tooling/generators test && pnpm --dir tooling/evals test && pnpm --dir tooling/release test && pnpm --dir tooling/brain-factory test",
    "test:workflow": "pnpm --dir tooling/workflow test",
    "test:pr-backlog": "pnpm --dir tooling/pr-backlog test",
    "test:stack": "pnpm --dir tooling/stack test",
    "brain:factory:materialize": "tsx tooling/brain-factory/src/materialize.mts",
    "brain:factory:check": "tsx tooling/brain-factory/src/check.mts",
    "brain:factory:dispatch": "tsx tooling/brain-factory/src/dispatch.mts",
    "brain:factory:integrate": "tsx tooling/brain-factory/src/integrate.mts",
    "brain:factory:integrate-wave": "tsx tooling/brain-factory/src/integrate-wave.mts",
    "brain:factory:promote-wave": "tsx tooling/brain-factory/src/promote-integration-wave.mts",
    "brain:factory:recover-wave": "tsx tooling/brain-factory/src/recover-integration-wave.mts",
    "brain:factory:recover-integration": "tsx tooling/brain-factory/src/recover-integration.mts",
    "brain:factory:lane-gates": "tsx tooling/brain-factory/src/lane-gates.mts",
    "brain:factory:check-confect-codegen": "tsx tooling/brain-factory/src/check-confect-codegen.mts",
    "brain:factory:resume": "tsx tooling/brain-factory/src/resume.mts",
    "stack:check": "tsx tooling/stack/check.mts",
    "stack:status": "tsx tooling/stack/status.mts",
    "stack:submit": "tsx tooling/stack/submit.mts",
    "stack:sync": "tsx tooling/stack/sync.mts",
    "stack:preflight": "tsx tooling/stack/merge-preflight.mts",
    "stack:merge": "tsx tooling/stack/merge.mts",
    "evals": "pnpm --dir tooling/evals test",
    "build": "turbo run build",
    "confect:codegen": "pnpm --dir packages/convex confect:codegen",
    "confect:manifest": "tsx tooling/confect-manifest/src/generate.ts",
    "confect:dev": "pnpm --dir packages/convex confect:dev",
    "convex:dev": "pnpm --dir packages/convex convex:dev",
    "dev:backend": "pnpm --dir packages/convex dev:backend",
    "template:init": "tsx tooling/generators/src/index.ts init",
    "template:doctor": "tsx tooling/generators/src/index.ts doctor",
    "template:quickstart": "tsx tooling/generators/src/index.ts quickstart",
    "template:intake": "tsx tooling/generators/src/index.ts intake",
    "template:seed-demo": "tsx tooling/generators/src/index.ts seed-demo",
    "template:handoff": "tsx tooling/generators/src/index.ts handoff",
    "template:add-client-domain": "tsx tooling/generators/src/index.ts add-client-domain",
    "template:add-capability": "tsx tooling/generators/src/index.ts add-capability",
    "template:add-workflow": "tsx tooling/generators/src/index.ts add-workflow",
    "template:add-agent": "tsx tooling/generators/src/index.ts add-agent",
    "template:add-agent-seat": "tsx tooling/generators/src/index.ts add-agent-seat",
    "template:promote-capability": "tsx tooling/generators/src/index.ts promote-capability",
    "template:promote-workflow": "tsx tooling/generators/src/index.ts promote-workflow",
    "template:workflow-output-smoke": "tsx tooling/generators/src/workflow-output-smoke.ts",
    "template:upgrade": "tsx tooling/generators/src/index.ts upgrade",
    "template:private-package:dry-run": "tsx tooling/generators/src/index.ts private-package:dry-run",
    "template:private-package:import": "tsx tooling/generators/src/index.ts private-package:import",
    "pattern-fit": "tsx scripts/pattern-fit.mts",
    "check:convex": "pnpm --dir packages/convex check:convex",
    "check:confect-compat": "tsx tooling/quality/check-confect-compat.mts",
    "check:ci-completeness": "tsx tooling/quality/check-ci-completeness.mts",
    "check:config-drift": "tsx tooling/quality/check-config-drift.mts",
    "check:deps": "tsx tooling/quality/check-deps.mts",
    "check:knip": "knip --config knip.json",
    "check:route-tree": "tsx tooling/quality/check-route-tree.mts",
    "check:frontend-effect-boundary": "tsx tooling/quality/check-frontend-effect-boundary.mts",
    "check:env-boundary": "tsx tooling/quality/check-env-boundary.mts",
    "check:provider-boundary": "tsx tooling/quality/check-provider-boundary.mts",
    "check:logging-boundary": "tsx tooling/quality/check-logging-boundary.mts",
    "check:access-audit-events": "tsx tooling/quality/check-access-audit-events.mts",
    "check:coverage-ratchet": "vitest run --coverage packages/template-core packages/integrations packages/search packages/storage packages/notifications packages/observability packages/convex tooling/quality tooling/workflow tooling/release tooling/generators tooling/stack apps/cli apps/web && tsx tooling/quality/check-coverage-ratchet.mts",
    "check:types-coverage": "type-coverage --project tsconfig.type-coverage.json --at-least 99.7",
    "check:gates": "tsx tooling/quality/check-gates.mts",
    "check:debt": "tsx tooling/quality/check-debt.mts",
    "check:generators": "tsx tooling/quality/check-generators.mts",
    "check:docs-freshness": "tsx tooling/quality/check-docs-freshness.mts",
    "check:generated-files": "tsx tooling/quality/check-generated-files.mts",
    "check:confect-v9": "tsx tooling/quality/check-confect-v9.mts",
    "check:confect-contracts": "tsx tooling/quality/check-confect-contracts.mts",
    "check:workflow-graph-boundary": "tsx tooling/quality/check-workflow-graph-boundary.mts",
    "check:schema-migration-notes": "tsx tooling/quality/check-schema-migration-notes.mts",
    "check:layer-boundaries": "depcruise --config dependency-cruiser.config.cjs apps packages tooling tests",
    "check:secret-canaries": "gitleaks detect --config .gitleaks.toml --no-git --redact --source .",
    "check:sbom-license": "tsx tooling/quality/check-sbom-license.mts",
    "check:headless-surface-contract": "tsx tooling/quality/check-headless-surface-contract.mts",
    "check:posthog-readiness": "tsx tooling/quality/check-posthog-readiness.mts",
    "check:confect-manifest": "pnpm --dir tooling/confect-manifest test && pnpm --dir tooling/confect-manifest typecheck && pnpm confect:manifest && git diff --exit-code packages/template-core/src/generated/confectManifest.ts",
    "check:effectified-api-proof": "pnpm --dir tooling/effectified-api-proof typecheck",
    "check:auth-demo-bypass": "tsx tooling/quality/check-auth-demo-bypass.mts",
    "check:pr-health": "tsx tooling/quality/check-pr-health.mts",
    "check:unresolved-review-threads": "tsx tooling/quality/check-unresolved-review-threads.mts",
    "check:merge-conflicts": "tsx tooling/quality/check-merge-conflicts.mts",
    "check:qlty": "tsx tooling/quality/check-qlty.mts",
    "contract-review": "tsx tooling/quality/contract-review.mts",
    "taste": "tsx tooling/quality/taste.mts",
    "taste:eval": "tsx tooling/quality/taste-eval.mts",
    "smoke:web-static": "tsx tooling/release/src/index.ts smoke-web-static",
    "review:readiness": "tsx tooling/release/src/index.ts review-readiness",
    "review:completion": "tsx tooling/release/src/index.ts review-completion",
    "smoke:hosted": "curl -fsSI ${TEMPLATE_HOSTED_URL:-https://maestro-template.pages.dev}",
    "smoke:hosted:browser": "playwright test tests/e2e/hosted-reference-app.spec.ts",
    "smoke:hosted:a11y": "playwright test tests/e2e/hosted-reference-app.accessibility.spec.ts",
    "smoke:hosted:visual": "playwright test tests/e2e/hosted-reference-app.visual.spec.ts",
    "deploy:doctor": "tsx tooling/release/src/index.ts deploy-doctor",
    "deploy:cloudflare": "VITE_CONVEX_URL=${VITE_CONVEX_URL:-$(node scripts/_project-config.mjs get production convexUrl)} pnpm build && pnpm smoke:web-static && pnpm dlx wrangler@latest pages deploy apps/web/dist/client --project-name ${CLOUDFLARE_PAGES_PROJECT:-maestro-template} --branch ${CLOUDFLARE_PAGES_BRANCH:-main} --commit-dirty=true",
    "test:mutation": "bash .buildkite/scripts/mutation.sh",
    "verify": "pnpm check:format && pnpm lint && pnpm typecheck && pnpm check:effect-diagnostics && pnpm test && pnpm test:tooling && pnpm test:workflow && pnpm test:pr-backlog && pnpm evals && pnpm build && pnpm check:ci-completeness && pnpm check:config-drift && pnpm check:deps && pnpm check:knip && pnpm check:route-tree && pnpm check:frontend-effect-boundary && pnpm check:env-boundary && pnpm check:provider-boundary && pnpm check:logging-boundary && pnpm check:access-audit-events && pnpm check:coverage-ratchet && pnpm check:types-coverage && pnpm check:gates && pnpm check:debt && pnpm check:generators && pnpm check:docs-freshness && pnpm check:generated-files && pnpm check:confect-v9 && pnpm check:confect-contracts && pnpm check:confect-compat && pnpm check:effectified-api-proof && pnpm check:workflow-graph-boundary && pnpm check:schema-migration-notes && pnpm check:layer-boundaries && pnpm check:secret-canaries && pnpm check:sbom-license && pnpm check:confect-manifest && pnpm check:headless-surface-contract && pnpm check:posthog-readiness && pnpm check:auth-demo-bypass && pnpm check:qlty",
    "coverage:update-baseline": "vitest run --coverage packages/template-core packages/integrations packages/search packages/storage packages/notifications packages/observability packages/convex tooling/quality tooling/workflow tooling/release tooling/generators tooling/stack apps/cli apps/web && tsx tooling/quality/check-coverage-ratchet.mts --update",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@effect/language-service": "^0.86.3",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.45.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "3.2.6",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^4.1.1",
    "knip": "^6.23.0",
    "lefthook": "1.10.5",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "@internationalized/date": "3.7.0",
      "@internationalized/number": "3.5.0",
      "@chakra-ui/react": "3.33.0",
      "@saas-ui/react": "3.0.0-next.51",
      "@saas-ui/forms": "3.0.0-next.52",
      "@saas-ui/modals": "3.0.0-next.52",
      "@saas-ui/hooks": "3.0.0-next.3",
      "@saas-ui-pro/react": "1.0.0-next.4"
    }
  }
}
