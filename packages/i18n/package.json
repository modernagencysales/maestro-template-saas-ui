{
  "name": "@workspace/i18n",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "extract": "formatjs extract './src/**/*.ts*' '../ui/**/*.ts*' '../../apps/web/{app,features}/**/*.ts*' --flatten",
    "compile": "formatjs compile",
    "extract-compile": "yarn extract --out-file temp.json && formatjs compile 'temp.json' --out-file lang/en.json && rm temp.json",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@formatjs/intl": "^4.1.2",
    "@formatjs/intl-localematcher": "^0.8.1",
    "@formatjs/ts-transformer": "^4.3.3",
    "date-fns": "^4.1.0",
    "intl-messageformat": "^11.1.2",
    "negotiator": "^1.0.0",
    "react-intl": "^8.1.3",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "zod": ">=4"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.12.2",
    "@types/react": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "react": "^19.2.0",
    "zod": "^4.1.13"
  }
}
