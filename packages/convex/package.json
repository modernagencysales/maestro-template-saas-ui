{
  "name": "@maestro-template/convex",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./refs": {
      "types": "./src/refs.ts",
      "default": "./dist/src/refs.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir dist --declaration",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --maxWorkers=1 --no-file-parallelism --exclude test/workflow-conformance.test.ts",
    "test:workflow-conformance": "vitest run test/workflow-conformance.test.ts --passWithNoTests --maxWorkers=1 --no-file-parallelism",
    "test:contract": "vitest run test/*contract*.test.ts test/**/contract*.test.ts",
    "confect:codegen": "confect codegen",
    "confect:dev": "confect dev",
    "convex:dev": "pnpm --dir ../.. convex:dev",
    "dev:backend": "concurrently -n confect,convex \"pnpm confect:dev\" \"pnpm convex:dev\"",
    "check:convex": "tsx ../../tooling/quality/check-convex-generation.mts"
  },
  "dependencies": {
    "@blocknote/core": "0.51.4",
    "@confect/cli": "10.0.0-next.9",
    "@confect/core": "10.0.0-next.9",
    "@confect/server": "10.0.0-next.9",
    "@confect/test": "10.0.0-next.9",
    "@convex-dev/prosemirror-sync": "0.2.5",
    "@maestro-template/observability": "workspace:*",
    "@maestro-template/template-core": "workspace:*",
    "@maestro-template/workflow-tooling": "workspace:*",
    "@tiptap/core": "3.27.1",
    "@tiptap/pm": "3.27.1",
    "@convex-dev/migrations": "0.3.5",
    "@convex-dev/workflow": "0.4.4",
    "@convex-dev/workpool": "0.4.7",
    "@posthog/convex": "2.0.32",
    "@effect/platform-node": "4.0.0-beta.102",
    "@effect/vitest": "4.0.0-beta.102",
    "convex": "1.42.1",
    "convex-test": "0.0.54",
    "effect": "4.0.0-beta.102",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
