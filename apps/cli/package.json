{
  "name": "@maestro-template/cli",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "maestro": "src/index.ts",
    "maestro-template": "src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir dist --declaration",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude src/factory/createRootIntegration.test.ts --exclude src/factory/customerCliRuntime.test.ts --exclude src/factory/productContractAcceptance.test.ts",
    "test:customer-cli-runtime": "vitest run src/factory/customerCliRuntime.test.ts --passWithNoTests --maxWorkers=1 --no-file-parallelism",
    "test:product-contract-admission": "vitest run src/factory/productContractAcceptance.test.ts -t 'validates generated customer product contract' --maxWorkers=1 --no-file-parallelism",
    "test:create-root-admission": "vitest run src/factory/productContractAcceptance.test.ts -t 'executes required Records product behaviors' --maxWorkers=1 --no-file-parallelism",
    "test:create-root-integration": "vitest run src/factory/createRootIntegration.test.ts --passWithNoTests --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "@maestro-template/app-map-tooling": "workspace:*",
    "@confect/js": "10.0.0-next.9",
    "@maestro-template/agent-pack": "workspace:*",
    "@maestro-template/generators": "workspace:*",
    "@maestro-template/integrations": "workspace:*",
    "@maestro-template/quality-tooling": "workspace:*",
    "@maestro-template/release-tooling": "workspace:*",
    "@maestro-template/template-core": "workspace:*",
    "@maestro-template/workflow-tooling": "workspace:*",
    "effect": "4.0.0-beta.102"
  }
}
