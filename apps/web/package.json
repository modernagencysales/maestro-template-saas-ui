{
  "name": "@maestro-template/web",
  "private": true,
  "type": "module",
  "imports": {
    "#config/*": "./src/config/*",
    "#components/*": "./src/components/*",
    "#features/*": "./src/features/*",
    "#hooks/*": "./src/hooks/*",
    "#lib/*": "./src/lib/*",
    "#theme/*": "./src/theme/*",
    "#utils/*": "./src/utils/*"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/check-client-bundle-budget.mjs && cp dist/client/_shell.html dist/client/index.html",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:runtime-longevity": "vitest run scripts/check-dev-runtime-longevity.test.mjs --maxWorkers=1 --no-file-parallelism",
    "test:bundle-budget": "vitest run scripts/check-client-bundle-budget.test.mjs --passWithNoTests"
  },
