{
  "name": "@maestro-template/web",
  "private": true,
  "type": "module",
  "imports": {
    "#config/*": "./src/config/*",
    "#components/*": "./src/components/*",
    "#features/*": "./src/features/*",
    "#hooks/*": "./src/hooks/*",
    "#lib/*": "./src/lib/*",
    "#theme/*": "./src/theme/*",
    "#utils/*": "./src/utils/*"
  },
  "main": "dist/index.js",
