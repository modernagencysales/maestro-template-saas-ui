{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "#config/*": ["src/config/*"],
      "#components/*": ["src/components/*"],
      "#features/*": ["src/features/*"],
      "#hooks/*": ["src/hooks/*"],
      "#lib/*": ["src/lib/*"],
      "#theme/*": ["src/theme/*"],
      "#utils/*": ["src/utils/*"],
      "@workspace/ui/*": ["src/components/*"],
      "@workspace/api/*": ["src/workspace/api/*"],
      "@workspace/i18n": ["src/workspace/i18n/index.ts"],
      "@workspace/config": ["src/workspace/config/index.ts"],
      "@workspace/better-auth/*": ["src/workspace/better-auth/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "test/**/*.mts"
  ]
}
