{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "include": ["dependencies"],
  "workspaces": {
    ".": {
      "entry": ["package.json"],
      "project": []
    },
    "apps/web": {
      "entry": [
        "src/start.ts",
        "src/routes/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}",
        "src/features/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": ["@confect/react"]
    },
    "packages/convex": {
      "ignoreDependencies": ["dodopayments"]
    },
    "packages/i18n": {
      "ignoreDependencies": [
        "@formatjs/intl-localematcher",
        "@formatjs/ts-transformer",
        "intl-messageformat",
        "negotiator",
        "server-only"
      ]
    },
    "packages/ui": {
      "entry": ["src/*/index.ts"],
      "ignoreDependencies": [
        "@internationalized/date",
        "@react-hookz/web",
        "@storybook/addon-essentials",
        "@storybook/addon-links",
        "@storybook/cli",
        "@tiptap/extension-mention",
        "@tiptap/extension-text-style",
        "@tiptap/suggestion",
        "@workspace/i18n",
        "date-fns",
        "prosemirror-commands",
        "prosemirror-dropcursor",
        "prosemirror-gapcursor",
        "prosemirror-history",
        "prosemirror-keymap",
        "prosemirror-model",
        "prosemirror-schema-list",
        "prosemirror-state",
        "prosemirror-transform",
        "prosemirror-view",
        "react-icons",
        "react-is"
      ]
    }
  },
  "ignoreDependencies": [
    "@blocknote/core",
    "@confect/js",
    "@confect/core",
    "@confect/server",
    "fast-check",
    "@confect/test",
    "@convex-dev/prosemirror-sync",
    "@convex-dev/workflow",
    "@effect/vitest",
    "@maestro-template/template-core",
    "@maestro-template/workflow-tooling",
    "@posthog/convex",
    "@tiptap/core",
    "@tiptap/pm",
    "convex",
    "decode-named-character-reference",
    "effect",
    "react",
    "react-dom",
    "tsx"
  ]
}
